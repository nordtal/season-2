# nordtal.eu season 2: every deployment setting, as a reference.
#
#   curl -fsSL https://raw.githubusercontent.com/nordtal/season-2/main/deploy/nordtal.sh | bash
#
# That script writes the environment file at STEWARD_ENV_FILE (mode 600), asks for what only a
# person knows and generates the secrets. Look names up here; do not copy this file to .env, since
# most settings belong to the service configs the web interface edits. The real file holds secrets
# and is never committed.
#
# REPLACE_ME fails validation by name, so a half-filled file stops with a clear message. Never
# replace it with zeros: a row of zeros is a valid snowflake.
#
# A commented-out line is optional and shows its default. An empty value means unset.
# Discord ids: turn on Developer Mode, then right-click a role or channel and copy its id.

# Profiles: db, bot, mc (proxy and the three Paper servers), backup and steward (steward-ui,
# steward-deployer, Caddy). Caddy is in `mc` too, so STEWARD_HOST and STEWARD_ACME_EMAIL are
# always required. steward-worker has no profile and always runs.
COMPOSE_PROFILES=db,bot,mc,backup,steward

TZ=Europe/Berlin

# Versions come from gradle.properties and the jars in the volumes, never from this file.
# `docker compose run --rm steward-worker report` prints what is installed.
# Where our jars and the resource pack are released.
SEASON_REPO=nordtal/season-2

# steward-worker applies the schema and installs every jar, and acts only on request:
#
#   docker compose run --rm steward-worker report     resolve and report, changes nothing
#   docker compose run --rm steward-worker migrate    apply the schema, nothing else
#   docker compose run --rm steward-worker bootstrap  migrate, then fill empty volumes
#
# It follows each repository's latest published GitHub release; a draft is invisible to it.
#
# Fill empty volumes before reporting ready. It never replaces an installed jar.
#STEWARD_WORKER_BOOTSTRAP=true
#
# Optional; raises GitHub's rate limit. Read access is enough.
#STEWARD_WORKER_GITHUB_TOKEN=

# Images are pulled from ghcr.io/nordtal as `latest` and must be public packages.
# Each override is a whole image reference, such as a local build.
#MC_IMAGE=ghcr.io/nordtal/minecraft:dev
#BOT_IMAGE=
#STEWARD_WORKER_IMAGE=

# The version every integration test runs against; a new major is a database migration.
#POSTGRES_IMAGE=postgres:17-alpine

# Minecraft
# Accepts https://aka.ms/MinecraftEULA.
EULA=true

# Velocity modern forwarding secret, from `openssl rand -hex 24`. Paper also writes it into each
# backend's paper-global.yml, so rotating it means editing those too.
VELOCITY_FORWARDING_SECRET=REPLACE_ME

PROXY_BIND=0.0.0.0
PROXY_PORT=25565

# The host:port players type, used for transfers between the proxies during an update. The port is
# required. Empty disables transfers, so an update takes the network down.
NETWORK_PUBLIC_ADDRESS=REPLACE_ME

# The standby proxy's port; open it (TCP) in the host firewall. It is only open during an update.
#PROXY_STANDBY_PORT=25566

# Simple Voice Chat needs UDP 25565 open beside TCP, and nothing else.

# Heap sizes; starting points, not measurements.
PROXY_HEAP=1G
LIMBO_HEAP=1G
# The network's player limit, shared by the three Paper backends; restart them after a change.
#NETWORK_MAX_PLAYERS=500

# Server browser MOTDs in MiniMessage, one per season phase: NETWORK_MOTD_PRE_LAUNCH, _PRE_EVENT,
# _START_EVENT, _SMP and _MAINTENANCE. Unset keeps network.yml's default. The client's own font
# draws them, so glyphs render as boxes.

HUNGER_GAMES_HEAP=4G
SMP_HEAP=6G

# A service's whole JVM command line; it replaces the heap setting, so include -Xmx.
#PROXY_JVM_OPTS=
#LIMBO_JVM_OPTS=
#HUNGER_GAMES_JVM_OPTS=
#SMP_JVM_OPTS=

# Seeds velocity.toml on a fresh volume only. Names match proxy's gate.yml#server-* keys.
#VELOCITY_SERVERS=limbo=limbo:25565 hunger-games=hunger-games:25565 smp=smp:25565
#VELOCITY_TRY=limbo

# Worldgen datapacks as <sha512>@<url>, fetched into <level-name>/datapacks before the first start.
# Must match the smp plugin's world-nordtal; see deploy/README.md#first-start-seeding.
#SMP_DATAPACK_URLS=f5283548323149ecd3f218b8efbe03c1c582df3f40b6bb3b095ba9e4cac0c87108b98adabd6ebd3a8037ec239773a253f75b8bee7db52e6f5663bf9dc63c2ea3@https://cdn.modrinth.com/data/8oi3bsk5/versions/CzijfXJQ/Terralith_26.2_v2.6.4.zip cf026b67f4fc0f5ab15229995f11faf43fdd41b29777a6756151276e83da65f887fe03b6356c5011f8ba32371f98941778928e4258e81b4c97411a40af1635ca@https://cdn.modrinth.com/data/tpehi7ww/versions/CS77UwHE/Dungeons%20and%20Taverns%20v5.3.2.zip
#SMP_LEVEL_NAME=nordtal

# Applied once, when the world is created; the datapacks above shape what it produces.
#SMP_LEVEL_SEED=1837371427

# The hand-built map; see deploy/README.md#getting-a-world-into-a-volume.
#HUNGER_GAMES_LEVEL_NAME=hunger_games

# Each server's plugins/, which holds the hand-edited configs. steward-worker mounts the same
# expressions, so change both sides together. Never point one into a checkout.
#PROXY_PLUGINS=mc-proxy-plugins
#LIMBO_PLUGINS=mc-limbo-plugins
#HUNGER_GAMES_PLUGINS=mc-hunger-games-plugins
#SMP_PLUGINS=mc-smp-plugins

# PostgreSQL, shared by every service through compose.yml.
POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
POSTGRES_PASSWORD=REPLACE_ME
# Loopback only, for a psql from the host.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# An external database: set these three and drop `db` from COMPOSE_PROFILES.
#NORDTAL_DATABASE_JDBC_URL=jdbc:postgresql://db.example.org:5432/nordtal
#NORDTAL_DATABASE_USERNAME=nordtal
#NORDTAL_DATABASE_PASSWORD=

# The bot's pool and SQL logging.
#NORDTAL_DATABASE_MAXIMUM_POOL_SIZE=10
#NORDTAL_DATABASE_LOG_SQL=false

# Discord bot
# Developer portal, your application, Bot, Reset Token.
NORDTAL_BOT_TOKEN=REPLACE_ME

# bunq, read by steward-worker: the API key and the monetary account id (a number, not an IBAN).
# Both or neither; without them no payments are taken.
#NORDTAL_STEWARD_BUNQ_API_KEY=
#NORDTAL_STEWARD_BUNQ_ACCOUNT_ID=

# The guild and the admin role are required; deploy/nordtal.sh asks for both. Every other id is
# optional, and the bot names the unset ones at startup.
NORDTAL_ACCESS_GUILD_ID=REPLACE_ME

# access      bot-owned, reconciled against the database; grant it with /grant-access
# donor       granted on a donation, never removed
# admin       read-only for the bot; grants admin rights everywhere
# admin-ping  mentioned in the admin channel
NORDTAL_ACCESS_ROLES_ADMIN=REPLACE_ME
#NORDTAL_ACCESS_ROLES_ACCESS=
#NORDTAL_ACCESS_ROLES_DONOR=
#NORDTAL_ACCESS_ROLES_ADMIN_PING=

# Alerts that need a human; unset, they go to the bot's log.
#NORDTAL_ACCESS_CHANNELS_ADMIN=

# Every language, as JSON. `tag` names the messages bundle and is the only required field; 'en' is
# mandatory. An empty id switches off what it names; a malformed one is refused.
#
#   role                  assigned by Discord onboarding, read-only for the bot
#   contribution-channel  the buy-access message and thank-yous
#   link-channel          the account-link message
#   hunger-games-channel  the Register message
#   status-channel        a channel the bot renames with the network status, usually a voice channel
#
# Unset, access.yml's default stands: `en` and `de` with blank ids.
NORDTAL_ACCESS_LANGUAGES='[
  {
    "tag": "en",
    "role": "REPLACE_ME",
    "contribution-channel": "REPLACE_ME",
    "link-channel": "REPLACE_ME",
    "hunger-games-channel": "REPLACE_ME",
    "status-channel": ""
  },
  {
    "tag": "de",
    "role": "REPLACE_ME",
    "contribution-channel": "REPLACE_ME",
    "link-channel": "REPLACE_ME",
    "hunger-games-channel": "REPLACE_ME",
    "status-channel": ""
  }
]'

# Access tiers, by day count; more days must cost more. Unset keeps 30 days for 3 EUR, 60 for 5,
# 90 for 7. Changing `days` retires a tier rather than repricing it.
#NORDTAL_ACCESS_TIERS='[
#  {"days": 30, "price-cents": 300},
#  {"days": 60, "price-cents": 500},
#  {"days": 90, "price-cents": 700}
#]'

# The donation surcharge in cents, and the threshold above which leftover money is a donation.
#NORDTAL_ACCESS_DONATION_CENTS=500

# Timings; unset keeps access.yml's values.
#NORDTAL_ACCESS_PAYMENT_POLL_INTERVAL_SECONDS=30
#NORDTAL_ACCESS_PAYMENT_REQUEST_TTL_HOURS=24
#NORDTAL_ACCESS_EXPIRY_REMINDER_LEAD_DAYS=3
#NORDTAL_ACCESS_ROLE_RECONCILE_INTERVAL_MINUTES=10

# bunq timings, read by steward-worker; each poll is a call to the bank.
#NORDTAL_STEWARD_BUNQ_POLL_INTERVAL_SECONDS=30
#NORDTAL_STEWARD_BUNQ_RECENT_PAYMENT_COUNT=50

# Leave empty on a fresh database: the first start stores its own cut-off. Set only to choose one
# deliberately (ISO-8601 UTC, e.g. 2026-09-01T00:00:00Z); emptying it restores the stored one.
#NORDTAL_STEWARD_BUNQ_WATERMARK=

# Steward: the web interface, the deployer and Caddy. deploy/nordtal.sh writes all of this.

# The interface's host name, without scheme. Chosen once: the certificate, the Discord redirect URI
# and security keys are bound to it.
STEWARD_HOST=steward.dev.nordtal.eu

# Receives Let's Encrypt's expiry warnings; required on every installation.
STEWARD_ACME_EMAIL=

# Two different secrets, each from `openssl rand -hex 32`.
#
#   STEWARD_API_TOKEN       steward-ui reading containers through steward-worker
#   STEWARD_DEPLOYER_TOKEN  steward-ui creating containers through steward-deployer
STEWARD_API_TOKEN=
STEWARD_DEPLOYER_TOKEN=

# This file's absolute path on the host.
STEWARD_ENV_FILE=/etc/nordtal/season-2.env

# Its directory and name, derived by deploy/nordtal.sh. The deployer mounts the directory, since a
# file bind would keep the old inode after a rotation.
STEWARD_ENV_DIR=/etc/nordtal
STEWARD_ENV_FILE_NAME=season-2.env

# The installation directory, absolute; every volume defaults to a folder under it.
NORDTAL_DIR=/srv/nordtal

# A value without a `/` is a Docker volume name instead of a path; deploy/dev.env.example uses that.
#
#PROXY_DATA=mc-proxy
#LIMBO_DATA=mc-limbo
# The standbys hold nothing worth keeping.
#PROXY_STANDBY_DATA=mc-proxy-standby
#LIMBO_STANDBY_DATA=mc-limbo-standby
#PROXY_STANDBY_PLUGINS=mc-proxy-standby-plugins
#LIMBO_STANDBY_PLUGINS=mc-limbo-standby-plugins
#HUNGER_GAMES_DATA=mc-hunger-games
#SMP_DATA=mc-smp
#PROXY_PLUGINS=mc-proxy-plugins
#LIMBO_PLUGINS=mc-limbo-plugins
#HUNGER_GAMES_PLUGINS=mc-hunger-games-plugins
#SMP_PLUGINS=mc-smp-plugins
#POSTGRES_DATA=postgres-data
#STEWARD_BACKUPS=steward-backups
#BOT_CONFIG=bot-config
#BOT_JAR=bot-jar
#STEWARD_WORKER_CONFIG=steward-worker-config
#STEWARD_WORKER_JAR=steward-worker-jar
#STEWARD_UI_CONFIG=steward-ui-config
#BUNQ_CONTEXT=bunq-context
#CADDY_DATA=caddy-data
#CADDY_CONFIG=caddy-config

# Discord sign-in, with the bot's application. Register https://${STEWARD_HOST}/auth/callback as
# the redirect URI. Empty disables sign-in.
STEWARD_UI_DISCORD_CLIENT_ID=
STEWARD_UI_DISCORD_CLIENT_SECRET=

# The interface also reads NORDTAL_ACCESS_GUILD_ID, NORDTAL_ACCESS_ROLES_ADMIN and, only to list
# role and channel names, NORDTAL_BOT_TOKEN. Whoever holds steward-ui therefore holds the bot.
