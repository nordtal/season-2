#!/bin/sh
# Refuses a commit message that is not a Conventional Commit or that names an issue-tracker ID.
set -eu

message=$(grep -v '^#' "$1")
subject=$(printf '%s\n' "$message" | sed -n '/[^[:space:]]/{p;q;}')

case "$subject" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|refactor|perf|test|docs|build|ci|chore|style'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^[:space:]]"; then
    echo "commit-msg: \"$subject\" is not type(scope): description with a type from $types." >&2
    exit 1
fi

if printf '%s\n' "$message" | grep -Eq '\b(steward|season-2-ops|season-2-ingame|season-2-community|workspace)/[0-9]+\b|\bNT[0-9]+-[0-9]+\b'; then
    echo "commit-msg: the message names an issue-tracker ID; write the reason instead." >&2
    exit 1
fi
