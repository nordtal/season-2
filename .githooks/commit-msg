#!/bin/sh
# Accepts one line `type(scope): outcome` that names no model, vendor or tracker ID. From the agent-kit template.
# With --names-only, as for a pull request body, it checks only the names and tracker IDs.
set -eu

# The pattern of this project's tracker IDs; empty when the project has no tracker.
tracker='NT[0-9]+-[0-9]+'

# `git commit -v` appends the diff below a scissors line.
message=$(sed '/^# -* >8 -*$/,$d' "$1" | grep -v '^#' | sed '/^[[:space:]]*$/d')
subject=$(printf '%s\n' "$message" | head -n 1)

if printf '%s\n' "$message" | grep -Eiq '\b(claude|anthropic|opus|sonnet|haiku|fable)\b|generated with|^co-authored-by:.*(\[bot\]|\bbot\b)|^claude-session:'; then
    echo "commit-msg: the message names a model or its vendor, a generated-with line, a bot co-author or a session; remove it." >&2
    exit 1
fi

if [ -n "$tracker" ] && printf '%s\n' "$message" | grep -Eq "\\b($tracker)\\b"; then
    echo "commit-msg: the message names a tracker ID; write the reason instead." >&2
    exit 1
fi

[ "${2:-}" = --names-only ] && exit 0

case "$subject" in
    "Merge "* | "Revert "*) exit 0 ;;
esac
# Outside CI, fixup and squash commits pass: they are squashed before a push.
if [ -z "${CI:-}" ]; then
    case "$subject" in
        "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
    esac
fi

if [ "$(printf '%s\n' "$message" | wc -l | tr -d ' ')" -ne 1 ]; then
    echo "commit-msg: one line only, no body." >&2
    exit 1
fi

types='feat|fix|refactor|perf|test|docs|build|ci|chore|style'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [a-z0-9].*[^.]\$"; then
    echo "commit-msg: \"$subject\" is not type(scope): outcome with a type from $types, a lowercase start and no trailing period." >&2
    exit 1
fi
