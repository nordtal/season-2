# Every directory pattern here is anchored with a leading slash. An unanchored `foo/` would match
# a directory named `foo` at any depth, including a Java package, and the result is an ignored
# file rather than an untracked one, so it never shows up in `git status`. A build directory in a
# place no pattern lists is therefore untracked instead, which is loud; `:checkSourcesTracked` in
# build-logic checks for it.

### Build output ###
/.gradle/
/*/.gradle/
/build/
/*/build/
/.kotlin/
/*/.kotlin/
!gradle/wrapper/gradle-wrapper.jar

### Secrets and runtime state. This repo is public - nothing below may ever be committed. ###
gradle.properties.local
*.env
.env
bunq-config.conf

# Runtime working directories of a server started in place.
/config/*
!/config/checkstyle/
/*/config/
/run/
/*/run/

# The four servers' plugins/ folders, bound into the containers by compose.yml (SERVERS_ROOT).
/deploy/servers/
# The pack zip the devpack profile serves on localhost. Built from resource-pack/, never edited.
/deploy/pack/
# Holds a generated database password, two Steward tokens and, once answered, a Discord
# application's client secret and bot token. Never commit it even with `git add -A`.
/deploy/dev.env
# Everything NORDTAL_DIR points at locally: worlds, jars, configs, the database's data directory.
/deploy/local/

### IDE ###
.idea/
*.iws
*.iml
*.ipr
/out/
/*/out/
.vscode/
.fleet/

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/bin/
/*/bin/

