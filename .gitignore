# Directory patterns are anchored: an unanchored `foo/` also ignores a Java package named `foo`.

### Build output ###
/.gradle/
/*/.gradle/
/build/
/*/build/
/.kotlin/
/*/.kotlin/
!gradle/wrapper/gradle-wrapper.jar

### Secrets and runtime state; this repo is public. ###
gradle.properties.local
*.env
.env
bunq-config.conf

# Runtime working directories of a server started in place.
/config/*
!/config/checkstyle/
/*/config/
/run/
/*/run/

# The servers' plugins/ folders, bound in by compose.yml.
/deploy/servers/
# The pack zip the devpack profile serves.
/deploy/pack/
# Local secrets: database password, Steward tokens, Discord credentials.
/deploy/dev.env
# The local NORDTAL_DIR: worlds, jars, configs, database.
/deploy/local/

### IDE ###
.idea/
*.iws
*.iml
*.ipr
/out/
/*/out/
.vscode/
.fleet/

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/bin/
/*/bin/

### Mac OS ###
.DS_Store

### The Minecraft instance the resource pack is installed into, one per machine ###
/resource-pack/minecraft-instance.properties
