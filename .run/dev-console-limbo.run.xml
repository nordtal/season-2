<!--
  dev console limbo

  limbo's log scrolls by, and every line typed into the Run window is sent as a console command.
  End the input with Ctrl-D, or stop the configuration; the server keeps running either way.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev console limbo" type="Application" factoryName="Application" folderName="dev: console and database">
    <option name="MAIN_CLASS_NAME" value="eu.nordtal.s2.dev.Dev" />
    <module name="season-2.dev.main" />
    <option name="PROGRAM_PARAMETERS" value="console limbo" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
