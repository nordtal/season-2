<!--
  dev deploy

  Rebuilds all four plugins, swaps the jars and restarts those four containers. The four
  single-server variants beside this one are the fast loop; this is the one after a change in
  :common, which all four carry.

  A JAR SWAP AND NOTHING ELSE: a changed deploy/dev.env does not reach a restarted container.
  Use `dev up` after editing that file.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev deploy (all four)" type="Application" factoryName="Application" folderName="dev: build and deploy">
    <option name="MAIN_CLASS_NAME" value="eu.nordtal.s2.dev.Dev" />
    <module name="season-2.dev.main" />
    <option name="PROGRAM_PARAMETERS" value="deploy" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
