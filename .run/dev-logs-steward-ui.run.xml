<!--
  dev logs steward-ui

  Only running once `dev ui` has named it - it is behind the `steward` profile, which the local
  COMPOSE_PROFILES does not select.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev logs steward-ui" type="Application" factoryName="Application" folderName="dev: logs">
    <option name="MAIN_CLASS_NAME" value="eu.nordtal.s2.dev.Dev" />
    <module name="season-2.dev.main" />
    <option name="PROGRAM_PARAMETERS" value="logs steward-ui" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
