<!--
  dev pack

  Builds the resource pack, copies the zip into PACK_ROOT and rewrites url and sha1 in the
  proxy's pack.yml - the same two lines steward-worker's PackWriter owns, and no others.

  THE PROXY HAS TO HAVE RUN ONCE so that pack.yml exists; this refuses with that sentence if it
  does not. It restarts the proxy at the end.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev pack" type="Application" factoryName="Application" folderName="dev: build and deploy">
    <option name="MAIN_CLASS_NAME" value="eu.nordtal.s2.dev.Dev" />
    <module name="season-2.dev.main" />
    <option name="PROGRAM_PARAMETERS" value="pack" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
