<!--
  dev reset smp

  DELETES THE SMP'S WHOLE VOLUME: world, .server cache, logs. On smp that world is Nordtal, which
  is in no repository and in no release.

  dev makes you TYPE THE SERVICE NAME BACK before it does anything - not "yes", the name -
  typed into the Run window. plugins/ is a directory on the host and
  survives. Nothing here weakens that guard; it only saves typing the command.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev reset smp" type="Application" factoryName="Application" folderName="dev: reset (destructive)">
    <option name="MAIN_CLASS_NAME" value="eu.nordtal.s2.dev.Dev" />
    <module name="season-2.dev.main" />
    <option name="PROGRAM_PARAMETERS" value="reset smp" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
