<!--
  dev ui

  The interface with hot reload: the stack in the background, steward-ui on 127.0.0.1:8080 and
  the Vite dev server in front on http://localhost:5173.

  STOPPING IT STOPS VITE AND LEAVES THE CONTAINERS UP. The counter-command is `dev stop`.

  This one is for editing steward-ui/frontend/src, where a saved file is a reload and nothing is
  rebuilt. Editing the Java is `:steward-ui:run` instead, and the two cannot run at once: both want
  :8080.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev ui" type="Application" factoryName="Application" folderName="dev: stack">
    <option name="MAIN_CLASS_NAME" value="eu.nordtal.s2.dev.Dev" />
    <module name="season-2.dev.main" />
    <option name="PROGRAM_PARAMETERS" value="ui" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
