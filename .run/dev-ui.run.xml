<!--
  deploy/dev ui

  The interface with hot reload: the stack in the background, steward-ui on 127.0.0.1:8080 and
  the Vite dev server in front on http://localhost:5173.

  CTRL-C STOPS VITE AND LEAVES THE CONTAINERS UP. The counter-command is `dev stop`.

  IT CANNOT RUN BESIDE `steward-ui (Java, :8080)` in this same folder - both want that port. That
  configuration is for editing the Java; this one is for editing steward-ui/frontend/src, where a
  saved file is a reload and nothing is rebuilt.

  Why this runs the way it does - the interpreter, the terminal, the working directory - is in
  .run/README.md, once, rather than in each of these thirty files.
-->
<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="dev ui" type="ShConfigurationType" folderName="dev: stack">
    <option name="SCRIPT_TEXT" value="" />
    <option name="INDEPENDENT_SCRIPT_PATH" value="true" />
    <option name="SCRIPT_PATH" value="$PROJECT_DIR$/deploy/dev" />
    <option name="SCRIPT_OPTIONS" value="ui" />
    <option name="INDEPENDENT_SCRIPT_WORKING_DIRECTORY" value="true" />
    <option name="SCRIPT_WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <option name="INDEPENDENT_INTERPRETER_PATH" value="true" />
    <option name="INTERPRETER_PATH" value="/usr/bin/env" />
    <option name="INTERPRETER_OPTIONS" value="bash" />
    <option name="EXECUTE_IN_TERMINAL" value="true" />
    <option name="EXECUTE_SCRIPT_FILE" value="true" />
    <envs />
    <method v="2" />
  </configuration>
</component>
