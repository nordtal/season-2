# nordtal.eu season 2 - deployment settings.
#
#   cp .env.example .env
#
# .env holds the Discord token, the bunq API key, the database password and the forwarding
# secret. It is gitignored and must never be committed. This repository is public.
#
# Nothing here has a plausible-looking default for a value nobody can guess: a setting that is
# wrong should stop the stack, not start something surprising.

# =============================================================================================
# What runs
# =============================================================================================
# db  = PostgreSQL      bot = the Discord bot      mc = proxy + the three Paper servers
COMPOSE_PROFILES=db,bot,mc

TZ=Europe/Berlin

# =============================================================================================
# Versions
# =============================================================================================
# The repo-wide version from gradle.properties. Plugin jars are named <module>-<version>.jar.
SEASON_VERSION=0.1.0
# The release tag those assets hang off. Must be the tag of the same version.
SEASON_RELEASE=v0.1.0
# The bot's image tag; must match gradle.properties too.
BOT_VERSION=0.1.0
SEASON_REPO=nordtal/season-2

# Server software. Pinned to an exact build - never "latest". Verified against the PaperMC Fill
# API on 2026-09-01: Paper 26.2 build 121 and Velocity 4.1.1 build 24 are the newest STABLE
# builds, and 121 is the build the version catalog compiles against.
#   https://fill.papermc.io/v3/projects/paper/versions/26.2/builds
#   https://fill.papermc.io/v3/projects/velocity/versions/4.1.1/builds
PAPER_VERSION=26.2
PAPER_BUILD=121
VELOCITY_VERSION=4.1.1
VELOCITY_BUILD=24

# The image built from ./minecraft. Leave MC_IMAGE unset to build locally.
MC_IMAGE_TAG=local
#MC_IMAGE=ghcr.io/nordtal/minecraft:0.1.0

# =============================================================================================
# Minecraft
# =============================================================================================
# Accepting https://aka.ms/MinecraftEULA. Deliberately not defaulted anywhere in the image.
EULA=true

# Velocity modern forwarding. Generate once, e.g. `openssl rand -hex 24`, and put THE SAME VALUE
# into each Paper backend's config/paper-global.yml - see README.md. A mismatch refuses every
# login with "Unable to connect you to the backend server".
VELOCITY_FORWARDING_SECRET=

PROXY_BIND=0.0.0.0
PROXY_PORT=25565

# Heaps. Unmeasured starting points, not measurements - the SMP's is the one that matters and it
# should be set from the real host once Nordtal's pre-generation has been run.
PROXY_HEAP=1G
LIMBO_HEAP=1G
HUNGER_GAMES_HEAP=4G
SMP_HEAP=6G

# Required third-party plugins on the SMP server only. DisplayTags is ours; PacketEvents 2.13.0
# is the first release with 26.2 support and is DisplayTags' stated minimum (checked 2026-09-01).
# Space-separated full URLs; the filename is taken from the URL.
#SMP_EXTRA_PLUGIN_URLS=

# =============================================================================================
# PostgreSQL
# =============================================================================================
POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
POSTGRES_PASSWORD=
# Loopback only. Everything that reads this database is in the same stack; the publish exists for
# backups and for a psql from the host.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Point this somewhere else to use a database outside the stack; then drop `db` from
# COMPOSE_PROFILES. The hostname `postgres` is this compose's own service.
#NORDTAL_DATABASE_JDBC_URL=
#NORDTAL_DATABASE_USERNAME=
#NORDTAL_DATABASE_PASSWORD=
#NORDTAL_DATABASE_MAXIMUM_POOL_SIZE=
#NORDTAL_DATABASE_LOG_SQL=

# =============================================================================================
# Discord bot
# =============================================================================================
NORDTAL_BOT_TOKEN=
NORDTAL_BOT_BUNQ_API_KEY=
NORDTAL_BOT_BUNQ_ACCOUNT_ID=
# SANDBOX or PRODUCTION
NORDTAL_BOT_BUNQ_ENVIRONMENT=SANDBOX

NORDTAL_ACCESS_GUILD_ID=
NORDTAL_ACCESS_ROLES_ACCESS=
NORDTAL_ACCESS_ROLES_DONOR=
NORDTAL_ACCESS_ROLES_ADMIN=
NORDTAL_ACCESS_ROLES_ADMIN_PING=
NORDTAL_ACCESS_CHANNELS_ADMIN=
# A JSON array - the only source for the language roles and channels.
NORDTAL_ACCESS_LANGUAGES=[]

# Optional; empty means "use what is in the file".
#NORDTAL_ACCESS_TIERS=
#NORDTAL_ACCESS_DONATION_CENTS=
#NORDTAL_ACCESS_PAYMENT_POLL_INTERVAL_SECONDS=
#NORDTAL_ACCESS_PAYMENT_REQUEST_TTL_HOURS=
#NORDTAL_ACCESS_PAYMENT_RECENT_PAYMENT_COUNT=
#NORDTAL_ACCESS_EXPIRY_REMINDER_LEAD_DAYS=
#NORDTAL_ACCESS_ROLE_RECONCILE_INTERVAL_MINUTES=
# LEAVE EMPTY ON A FRESH DATABASE. The first start stamps its own instant and no later start
# rewrites it. Without it the first poll books up to 50 historical bunq payments.
#NORDTAL_ACCESS_PAYMENT_WATERMARK=
