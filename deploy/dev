#!/usr/bin/env bash
#
# The local season 2 network: the SAME compose.yml, the same Dockerfiles and the same
# steward-worker that the production host runs, pointed at locally built jars.
#
# What makes that possible is one line in compose.yml: each server's plugins/ is a directory on
# this machine (<SERVICE>_PLUGINS) rather than a volume of its own. So installing a freshly built
# plugin is a `cp` and a restart of one container, and reading plugins/smp/config.yml is opening a
# file. Worlds, the .server/ jar cache and logs stay in the volumes, where the nightly backup can
# still find them.
#
#   deploy/dev init                 write deploy/dev.env: the four secrets generated, the handful of
#                                   things only a person knows asked for in nordtal.sh's own words
#   deploy/dev up                   build everything, then bring the stack up
#   deploy/dev deploy [module...]   rebuild those modules and restart their servers (default: all)
#                                   (a JAR swap. After editing deploy/dev.env, run `up` instead:
#                                    `restart` reuses the container and its environment with it)
#   deploy/dev pack                 build the resource pack and point the proxy at it
#   deploy/dev ui                   the interface: the stack in the background, Vite in front
#                                   (http://localhost:5173. Ctrl-C leaves the containers up)
#   deploy/dev logs [service]       follow the logs
#   deploy/dev console <service>    attach to the real server console (Ctrl-b then d to detach)
#   deploy/dev mc <service> <cmd>   send one console command
#   deploy/dev psql                 a psql shell on the local database
#   deploy/dev ps | stop | down     the usual
#   deploy/dev reset <service>      throw away one server's WORLD volume - see the guard below
#
# Everything here runs from the repository root whatever directory it is called from.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# --- the questions, borrowed rather than copied (season-2-ops/147) --------------------------------
# THE CUT IS TILL'S AND IT IS EXACT: the two scripts share the QUESTIONS and nothing else. Sourcing
# `deploy/nordtal.sh` stops at its own seam - everything below that line is the installation, and
# none of it runs here - so what arrives is the table (QUESTIONS, QUESTION_KIND, QUESTION_CHECK,
# QUESTION_PROMPT, QUESTION_HINT), the shape checks, `env_value`/`set_assignment`, and the four
# functions that ask and write down an answer.
#
# NOT SHARED, and this is the point rather than an omission: pulling images instead of building
# them, /etc/nordtal, waiting for DNS and Let's Encrypt, the self-update out of GitHub, `chown`,
# root. A local stack is a checkout and a `docker compose`, and none of that belongs in it.
#
# IT IS SOURCED HERE, BEFORE THIS FILE'S OWN DEFINITIONS, on purpose. nordtal.sh defines `log`,
# `warn` and `die` too, and they print `[nordtal]`; sourcing it afterwards would relabel every line
# this script prints. Whoever is defined last wins, so this script's own three are below.
# shellcheck source=deploy/nordtal.sh
source "$ROOT/deploy/nordtal.sh"

ENV_FILE="deploy/dev.env"
EXAMPLE="deploy/dev.env.example"
# `ask_for`, `default_for` and `set_secret` read this: it is nordtal.sh's --check, and there is no
# local equivalent of one. Set here because those functions come from a file that no longer runs
# its own argument parsing when it is sourced.
CHECK_ONLY=false

# The four services that run one of our plugins, and the module that builds it. The service name is
# also the <SERVICE>_PLUGINS variable's - the same identity compose.yml and :steward-worker's Topology use.
MODULES=(proxy limbo hunger-games smp)

log()  { printf '\033[36m[dev]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[dev]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[31m[dev]\033[0m %s\n' "$*" >&2; exit 1; }

# --- the guard on the one destructive command ---------------------------------------------------
# `reset` deletes a server's whole volume, and on smp that volume holds Nordtal - a hand-built world
# that exists in no repository and in no release. deploy/minecraft/entrypoint-test.sh exists for
# exactly this class of thing, and so does deploy/dev-test.sh, which sources this file to drive the
# two functions below without Docker.
#
# Two rules, and both are here rather than at the call site so that a future subcommand cannot
# quietly skip them:
#   1. a service has to be NAMED. `reset` on its own resets nothing.
#   2. the name has to be typed BACK. Not "yes", not "y" - the name, so that a person who is not
#      reading cannot agree to something they did not pick.
known_service() {
    local wanted="$1"
    local service
    for service in "${MODULES[@]}"; do
        [[ "$service" == "$wanted" ]] && return 0
    done
    return 1
}

# Whether a typed confirmation matches. Kept separate from the prompt so it can be tested; a
# comparison that quietly accepts anything is the failure this whole guard exists to prevent.
reset_confirmed() {
    local wanted="$1" typed="$2"
    [[ -n "$wanted" && "$typed" == "$wanted" ]]
}

# --- which of the shared questions a local setup asks (season-2-ops/147) --------------------------
# The table is nordtal.sh's; the SELECTION is this file's, because the two setups are not the same
# setup. What falls away locally is everything a public deployment needs and a checkout does not:
#
#   STEWARD_ACME_EMAIL      Let's Encrypt never runs here - Caddy is not started locally at all.
#   STEWARD_HOST            only Caddy and the default public URL below use it, and the example's
#                           `steward.localhost` is right for both.
#   NETWORK_PUBLIC_ADDRESS  nobody joins this network from the internet.
#   the two bunq values     a local stack polls no bank. steward-worker says "bunq is OFF" in its
#                           first log line, which is the documented state and not a fault.
#   COMPOSE_PROFILES        the example already carries the local selection.
#
# And one question is added, because season-2-ops/146 showed that without it the interface cannot
# start at all: the address the BROWSER uses. It is asked rather than assumed because it is the one
# thing that differs between "a container on this machine" and "a Vite dev server in front of it",
# and `webauthn.relying-party-id` is then DERIVED from it rather than asked for a second time - it
# has to be that host or a parent of it, so asking twice is only a way to get it wrong.
LOCAL_QUESTIONS=(
    EULA
    STEWARD_UI_PUBLIC_URL
    NORDTAL_BOT_TOKEN
    STEWARD_UI_DISCORD_CLIENT_ID
    STEWARD_UI_DISCORD_CLIENT_SECRET
    NORDTAL_ACCESS_GUILD_ID
    NORDTAL_ACCESS_ROLES_ADMIN
)

# A URL a browser is pointed at: scheme, host, optional port, and nothing after it. The same rule
# `Configs.requirePublicUrl` enforces at startup, refused here where it can still be retyped.
looks_like_browser_url() {
    [[ "$1" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?$ ]]
}

# The host out of such a URL: no scheme, no port. What the relying party id has to be.
host_of_url() {
    local rest="${1#*://}"
    printf '%s' "${rest%%:*}"
}

# THE FIVE DISCORD ANSWERS ARE OPTIONAL HERE AND REQUIRED THERE, and that is the whole difference
# between a deployment and a checkout. A production install with no bot token is a broken
# deployment; a local one is a stack that comes up, runs four servers and a database, and simply
# has no bot and nobody able to sign in - which is the right state to be in until there is a test
# application and a test guild to point it at (season-2-ops/150). Pressing Enter writes nothing, so
# the example's harmless placeholder stays and compose still interpolates.
LOCAL_KINDS_APPLIED=false
apply_local_questions() {
    $LOCAL_KINDS_APPLIED && return 0
    LOCAL_KINDS_APPLIED=true

    QUESTION_KIND[NORDTAL_BOT_TOKEN]=optional-secret
    QUESTION_KIND[STEWARD_UI_DISCORD_CLIENT_ID]=optional-plain
    QUESTION_KIND[STEWARD_UI_DISCORD_CLIENT_SECRET]=optional-secret
    QUESTION_KIND[NORDTAL_ACCESS_GUILD_ID]=optional-plain
    QUESTION_KIND[NORDTAL_ACCESS_ROLES_ADMIN]=optional-plain

    local skip="Press Enter to skip: the stack still comes up, the bot simply does not run and
        nobody can sign in to the interface. season-2-ops/150 is the test application this wants."
    QUESTION_HINT[NORDTAL_BOT_TOKEN]="A TEST application's token, never the production bot's - it would
        join the real guild from your laptop. $skip"
    QUESTION_HINT[STEWARD_UI_DISCORD_CLIENT_ID]="The same test application, OAuth2 page. Its redirect URI
        has to be <the address above>/auth/callback. $skip"
    QUESTION_HINT[STEWARD_UI_DISCORD_CLIENT_SECRET]="OAuth2 -> Reset Secret, on the test application. $skip"
    QUESTION_HINT[NORDTAL_ACCESS_GUILD_ID]="A test guild, not the real one. $skip"
    QUESTION_HINT[NORDTAL_ACCESS_ROLES_ADMIN]="The admin role in that test guild - it is what decides who
        may sign in to the interface at all, so your own account needs it. $skip"

    QUESTION_KIND[STEWARD_UI_PUBLIC_URL]=plain
    QUESTION_CHECK[STEWARD_UI_PUBLIC_URL]=looks_like_browser_url
    QUESTION_PROMPT[STEWARD_UI_PUBLIC_URL]="What address will you open the interface on?"
    QUESTION_HINT[STEWARD_UI_PUBLIC_URL]="Scheme and host, no path - http://steward.localhost:8080 is the
        container itself and is the answer if you are not running the Vite dev server. Discord gets
        this plus /auth/callback as its redirect URI, and every security key is bound to its host."
}

# Asks the local selection and writes down what comes back. `again` on every one of them: this runs
# on a freshly copied example, so every value already has a placeholder in it and nothing would be
# asked otherwise.
ask_local_questions() {
    apply_local_questions
    local question
    for question in "${LOCAL_QUESTIONS[@]}"; do
        if [[ "$question" == EULA ]]; then
            ask_question EULA again || die "the EULA was not accepted, so there are no servers to
       start. $ENV_FILE has been written as far as this point and can be removed."
            continue
        fi
        ask_question "$question" again || true
    done

    # Derived, never asked. steward-ui refuses to start when these two disagree, and the refusal is
    # correct: a key registered against the wrong domain is one the browser silently declines.
    local url host
    url="$(env_value "$ENV_FILE" STEWARD_UI_PUBLIC_URL)"
    [[ -n "$url" ]] || return 0
    host="$(host_of_url "$url")"
    set_assignment "$ENV_FILE" STEWARD_WEBAUTHN_RP_ID "$host"
    log "STEWARD_WEBAUTHN_RP_ID = $host (derived from the address above)"

    # AND THE ONE ANSWER THAT DOES NOT WORK, said here rather than found later:
    # `Configs.requireRelyingParty` wants at least a name and a suffix, because a browser refuses a
    # relying party id that is a public suffix. `localhost` is the one named exception to that
    # (season-2-ops/148) and needs nothing here; any OTHER single label - `intranet`, a machine
    # name off a company resolver - is refused, and refused at startup with a sentence naming both
    # values. Saying so now costs a line and saves reading a stack trace.
    if [[ "$host" != *.* && "$host" != localhost ]]; then
        warn "$host has no dot in it, so steward-ui will refuse to start: a relying party id has to
       be a registrable domain, and localhost is the only single label that is allowed. Use
       http://localhost:5173 for the dev server, http://steward.localhost:8080 for the container.
       Everything else in $ENV_FILE is written and only this one line needs changing."
    fi
}

# --- sourced rather than executed ----------------------------------------------------------------
# Everything ABOVE this line is definitions; everything below reaches for Gradle, Docker and the
# working tree. dev-test.sh sources this file to exercise the reset guard, the same way
# entrypoint-test.sh sources entrypoint.sh - see the long comment there.
[[ "${BASH_SOURCE[0]}" == "${0}" ]] || return 0

cd "$ROOT"

# `sed -n '1p'`, not `head -n1` (season-2-ops/27, 2026-09-17): head closes the pipe the moment it
# has its line, and under this file's `set -Eeuo pipefail` that turns sed's SIGPIPE into this
# function's exit status. gradle.properties carries exactly one `version=` line by design (one
# repo-wide version drives every artifact - see the root CLAUDE.md), so this almost never showed,
# which is exactly the shape of the bug: found while building the season-2-ops/27 guard, not by
# anyone hitting it.
version() { sed -n 's/^version=//p' gradle.properties | sed -n '1p'; }

compose() {
    [[ -f "$ENV_FILE" ]] || die "$ENV_FILE is not there. Run: deploy/dev init"
    docker compose --env-file "$ENV_FILE" "$@"
}

plugins_dir() {
    # Where one service's plugins/ lives on THIS machine. compose.yml defaults each of these to a
    # named volume (mc-<service>-plugins) because production must not keep its configs inside the
    # directory a deployment checks out over; deploy/dev.env sets them to paths instead, which is what
    # makes a local `cp` of a jar and a plain `$EDITOR` on config.yml possible at all.
    #
    # So this reads the variable rather than assuming a layout, and REFUSES a value with no `/` in
    # it: that is a volume name to Docker, and there is nothing here that can copy a file into one.
    # Falling back to ./deploy/servers instead would silently write jars into a directory no
    # container has mounted, which reads exactly like a build that worked.
    local service="$1" var value
    var="$(printf '%s' "$service" | tr 'a-z-' 'A-Z_')_PLUGINS"
    value="$(sed -n "s/^$var=//p" "$ENV_FILE" 2>/dev/null | tail -n1)"
    [[ -n "$value" ]] || die "$ENV_FILE sets no $var. The local stack needs a path there; see $EXAMPLE"
    [[ "$value" == */* ]] || die "$var is '$value', which Docker reads as a VOLUME NAME, not a path."\
" The local stack cannot copy jars or read configs out of a volume - set it to a directory."
    printf '%s' "$value"
}

pack_root() {
    # The same read, for the directory pack-host serves. Hardcoded as deploy/pack in two places
    # until 2026-09-06: with PACK_ROOT pointed anywhere else, `deploy/dev pack` wrote a correct URL
    # and SHA-1 into pack.yml for a zip the host does not serve, and every client then failed the
    # download with nothing saying why (finding 112).
    local value
    value="$(sed -n 's/^PACK_ROOT=//p' "$ENV_FILE" 2>/dev/null | tail -n1)"
    printf '%s' "${value:-./deploy/pack}"
}

compose_project() {
    # What Docker labels this project's volumes with, in compose's own order of precedence:
    # COMPOSE_PROJECT_NAME from the env file, then compose.yml's top-level name:, then the
    # directory name. It is nordtal-s2 here and NOT season-2, which is exactly why this reads the
    # file instead of assuming the default.
    local value
    value="$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "$ENV_FILE" 2>/dev/null | tail -n1)"
    # `sed -n '1p'`, not `head -n1` - same reason as version() above: compose.yml's top-level
    # `name:` is unique by construction, but the anti-pattern is the same regardless of how likely
    # a second match is (season-2-ops/27).
    [[ -n "$value" ]] || value="$(sed -n 's/^name: *//p' "$ROOT/compose.yml" 2>/dev/null | sed -n '1p')"
    [[ -n "$value" ]] || value="$(basename "$ROOT" | tr '[:upper:]' '[:lower:]')"
    printf '%s' "$value"
}

# The jar a module's shadowJar produces. Named rather than globbed so a stale jar from an older
# version cannot be picked up silently.
jar_of() { printf '%s/build/libs/%s-%s.jar' "$1" "$1" "$(version)"; }

# --- init ----------------------------------------------------------------------------------------
cmd_init() {
    if [[ -f "$ENV_FILE" ]]; then
        log "$ENV_FILE already exists; leaving it alone"
    else
        # The example is still the base, and it stays one: ~290 lines of local paths, ports and
        # profiles that nobody should be asked about. What it is NOT any more is the place a person
        # fills in by hand - the four REPLACE_ME secrets are generated and the questions below are
        # asked, in nordtal.sh's own words (season-2-ops/147).
        cp "$EXAMPLE" "$ENV_FILE"
        log "wrote $ENV_FILE from $EXAMPLE"

        command -v openssl >/dev/null 2>&1 || die "no openssl, and four secrets have to come from
       somewhere. Install it, or put POSTGRES_PASSWORD, VELOCITY_FORWARDING_SECRET,
       STEWARD_API_TOKEN and STEWARD_DEPLOYER_TOKEN into $ENV_FILE yourself - not the same twice."
        set_secret POSTGRES_PASSWORD 24
        set_secret VELOCITY_FORWARDING_SECRET 24
        set_secret STEWARD_API_TOKEN
        set_secret STEWARD_DEPLOYER_TOKEN
        # The same boundary production keeps: reading containers and creating them are different
        # privileges, and one token for both makes that a comment rather than a rule.
        [[ "$(env_value "$ENV_FILE" STEWARD_API_TOKEN)" \
            != "$(env_value "$ENV_FILE" STEWARD_DEPLOYER_TOKEN)" ]] \
            || die "STEWARD_API_TOKEN and STEWARD_DEPLOYER_TOKEN came out the same."

        ask_local_questions

        local leftovers; leftovers="$(env_replace_me_lines "$ENV_FILE")"
        [[ -z "$leftovers" ]] || warn "REPLACE_ME is still in $ENV_FILE at line(s):"\
" $(tr '\n' ' ' <<<"$leftovers"). Nothing generated a value for those."
    fi

    local service
    for service in "${MODULES[@]}"; do
        mkdir -p "$(plugins_dir "$service")"
    done
    mkdir -p "$(pack_root)"
    log "plugin directories: $(plugins_dir smp) and its three siblings - jars and configs live there"
    log "next: deploy/dev up"
}

# --- building and installing ---------------------------------------------------------------------
build_modules() {
    local modules=("$@")
    local tasks=()
    local module
    for module in "${modules[@]}"; do
        tasks+=(":$module:shadowJar")
    done
    log "building: ${modules[*]}"
    sh gradlew "${tasks[@]}"
}

install_module() {
    local module="$1"
    local jar target
    jar="$(jar_of "$module")"
    [[ -f "$jar" ]] || die "$jar was not built"
    target="$(plugins_dir "$module")"
    mkdir -p "$target"

    # Remove every other jar of this plugin first. steward-worker splits a filename on the LAST
    # hyphen (JarName), and so does entrypoint.sh; two jars sharing a prefix is Paper loading two
    # versions of one plugin without complaining about it.
    local existing
    for existing in "$target/$module-"*.jar; do
        [[ -e "$existing" ]] || continue
        [[ "$(basename "$existing")" == "$(basename "$jar")" ]] && continue
        rm -f "$existing"
        log "removed superseded $(basename "$existing")"
    done

    cp "$jar" "$target/"
    log "installed $(basename "$jar") into $target"
}

# --- up ------------------------------------------------------------------------------------------
cmd_up() {
    [[ -f "$ENV_FILE" ]] || die "$ENV_FILE is not there. Run: deploy/dev init"
    build_modules "${MODULES[@]}"
    sh gradlew :steward-worker:shadowJar

    local module
    for module in "${MODULES[@]}"; do
        install_module "$module"
    done

    # The images are ours and are built here, never pulled: a locally built plugin needs the locally
    # built steward-worker, because the migrations it applies are compiled into :common and shaded
    # into that jar. A stale ghcr worker would migrate to the released schema and the plugin would
    # come up against it.
    log "building the minecraft and steward-worker images"
    compose build steward-worker proxy

    # Our jars are already in plugins/, so the worker's bootstrap - which installs only what is
    # MISSING - fetches the third-party plugins, the Paper and Velocity jars and pack.yml, and
    # leaves ours alone. That is the whole of the first start.
    compose up -d
    log "up. First start downloads Paper, Velocity and the third-party plugins; give it a few"
    log "minutes and watch with: deploy/dev logs"
}

# --- deploy --------------------------------------------------------------------------------------
cmd_deploy() {
    local modules=("$@")
    (( ${#modules[@]} == 0 )) && modules=("${MODULES[@]}")

    local module
    for module in "${modules[@]}"; do
        known_service "$module" || die "unknown module '$module'. One of: ${MODULES[*]}"
    done

    build_modules "${modules[@]}"
    for module in "${modules[@]}"; do
        install_module "$module"
    done
    # restart and not `up -d`: the jar is a file the container reads at start, so restarting the
    # existing container is enough and is the fast path this whole command exists for. The cost is
    # that a change to deploy/dev.env does NOT reach a restarted container - compose would have to
    # recreate it - which is why `up` is the answer after editing that file. Measured the hard way
    # on 2026-09-05: a switch set in dev.env, a `deploy`, and a server still on the old value.
    log "restarting: ${modules[*]}"
    compose restart "${modules[@]}"
}

# --- pack ----------------------------------------------------------------------------------------
cmd_pack() {
    sh gradlew :resource-pack:packZip
    local zip sha name pack_yml
    zip="resource-pack/build/distributions/nordtal-resource-pack-$(version).zip"
    [[ -f "$zip" ]] || die "$zip was not built"
    name="$(basename "$zip")"
    local pack_dir
    pack_dir="$(pack_root)"
    mkdir -p "$pack_dir"
    cp "$zip" "$pack_dir/$name"
    sha="$(shasum -a 1 "$zip" | cut -d' ' -f1)"

    pack_yml="$(plugins_dir proxy)/proxy/pack.yml"
    [[ -f "$pack_yml" ]] || die "$pack_yml is not there yet - bring the proxy up once so it writes"

    local port
    port="$(sed -n 's/^PACK_PORT=//p' "$ENV_FILE" | tail -n1)"
    port="${port:-8080}"

    # THE SAME TWO LINES STEWARD-WORKER'S PackWriter OWNS, and no others. It rewrites url and sha1
    # and has no opinion about enabled, force or apply-timeout-seconds; neither does this.
    perl -pi -e "s|^url:.*|url: \"http://localhost:$port/$name\"|" "$pack_yml"
    perl -pi -e "s|^sha1:.*|sha1: \"$sha\"|" "$pack_yml"
    log "pack.yml now points at http://localhost:$port/$name ($sha)"

    compose restart proxy
}

# --- ui ------------------------------------------------------------------------------------------
# The interface, with a browser in front of it and hot reload behind (season-2-ops/149).
#
# THE DEFAULT IS THE CONTAINER. steward-ui is published on 127.0.0.1:8080 (season-2-ops/146) and
# the Vite dev server proxies /api and /auth to it, so working on the frontend needs Docker and
# Node and no JDK in the foreground at all. The other half - editing the Java - is the run
# configuration in `.run/`, and the two CANNOT run at once: both want :8080. That is a sentence
# here and in the README rather than a surprise in a log file.
#
# CADDY STAYS OUT, and it is left out BY NAME rather than by a profile of its own. Naming a
# service activates its profile, so `steward` need not be in COMPOSE_PROFILES either; a new profile
# would have to be added to the production selection in /etc/nordtal/season-2.env as well, and
# forgetting that makes the interface unreachable from the internet. Locally Caddy has nothing to
# do: there is no name it could get a certificate for.
cmd_ui() {
    [[ -f "$ENV_FILE" ]] || die "$ENV_FILE is not there. Run: deploy/dev init"

    # ONE PORT, TWO LOCAL PROFILES. pack-host and steward-ui both default to 127.0.0.1:8080, and
    # `devpack` is on in every local env file. Docker's own message for that is about a bind
    # address, three services after the one that matters, so the collision is named here instead.
    local pack_port steward_port
    pack_port="$(sed -n 's/^PACK_PORT=//p' "$ENV_FILE" | tail -n1)"
    steward_port="$(sed -n 's/^STEWARD_UI_PORT=//p' "$ENV_FILE" | tail -n1)"
    if [[ "${pack_port:-8080}" == "${steward_port:-8080}" ]]; then
        die "PACK_PORT and STEWARD_UI_PORT are both ${steward_port:-8080} in $ENV_FILE, and the
       resource pack host and the interface cannot both have it. Set PACK_PORT=8081 - the pack
       URL is written by 'deploy/dev pack', which reads that value, so nothing else has to change."
    fi

    # THE WHOLE STACK, not the four services the interface reads directly: what it draws is the
    # servers, their plugins and their players, and a page whose every card says "not running" is
    # not the page anybody wants to work on. COMPOSE_PROFILES picks what that means - db,mc,devpack
    # locally - and the three steward services are named rather than added to it, because `steward`
    # carries Caddy as well and a laptop has no certificate for it.
    log "bringing up the stack ($(sed -n 's/^COMPOSE_PROFILES=//p' "$ENV_FILE" | tail -n1))"
    compose up -d
    log "and the three services the interface is"
    compose up -d steward-worker steward-ui steward-deployer

    # THE PRIVATE NODE IS SEARCHED FOR, NEVER SPELLED OUT. The directory carries the platform in
    # its name - node-v24.21.0-linux-x64 here, something else on a Mac - so a written path works on
    # exactly one machine. Gradle downloads it and installs the packages; this only has to find it
    # afterwards. (`npx vitest` with no node on PATH exits 0 having tested nothing, which is how
    # this matters.)
    log "node and the npm packages, through Gradle - the only supported way to get them"
    sh gradlew :steward-ui:npmInstall

    local node
    # `sed -n '1p'` and not `head -n1`: under this file's pipefail a head that closes the pipe
    # early turns find into a SIGPIPE, and deploy/pipe-safety-test.sh refuses the pattern outright.
    node="$(find "$ROOT/steward-ui/build/nodejs" -maxdepth 2 -type d -name bin 2>/dev/null | sed -n '1p')"
    [[ -n "$node" ]] || die "no node under steward-ui/build/nodejs after :steward-ui:npmInstall.
       That task downloads it; if it did not, its output says why - there is no 'install node
       first' step to fall back on."

    log "the interface is on http://localhost:5173 - the container itself is on 127.0.0.1:${steward_port:-8080}"
    log "Ctrl-C stops Vite and LEAVES THE CONTAINERS RUNNING. The counter-command is: deploy/dev stop"
    PATH="$node:$PATH" npm --prefix "$ROOT/steward-ui/frontend" run dev
}

# --- the rest ------------------------------------------------------------------------------------
cmd_logs()    { compose logs -f "$@"; }
cmd_ps()      { compose ps; }
cmd_stop()    { compose stop; }
cmd_down()    { compose down; }
cmd_console() { [[ $# -eq 1 ]] || die "usage: deploy/dev console <service>"; compose exec "$1" console; }
cmd_mc()      { [[ $# -ge 2 ]] || die "usage: deploy/dev mc <service> <command>"; local s="$1"; shift; compose exec "$s" mc "$@"; }
cmd_psql()    { compose exec postgres sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"'; }

cmd_reset() {
    local service="${1:-}"
    known_service "$service" \
        || die "usage: deploy/dev reset <service>, one of: ${MODULES[*]}. A service has to be named:
this deletes that server's volume, which on smp is Nordtal - a hand-built world that is in no
repository and in no release."

    printf 'This deletes the %s container AND its volume: world, .server cache, logs.\n' "$service"
    printf 'plugins/ is a directory on the host and survives.\n'
    printf 'Type the service name to confirm: '
    local typed
    read -r typed
    reset_confirmed "$service" "$typed" || die "not confirmed; nothing was deleted"

    # `compose rm -v` only removes ANONYMOUS volumes, so it would take the container and leave the
    # world exactly where it was - a reset that reports success and resets nothing. The volume is
    # found by Docker's own compose labels rather than by guessing "<project>_mc-<service>", and an
    # ambiguous answer stops here: deleting the wrong project's world is the one mistake this
    # command must not be able to make.
    # The volume is read off the container while it still exists, which is exact: whatever is
    # mounted at /data is this project's world by definition. Only if there is no container does
    # this fall back to the labels - and then on BOTH of them. The fallback filtered on the logical
    # name alone until 2026-09-06, so a single mc-smp volume belonging to another compose project on
    # this machine passed the "exactly one" check and was deleted (finding 113).
    local volume
    # `sed -n '1p'`, not `head -n1` (season-2-ops/27, 2026-09-17): `compose ps -aq` is a real
    # subprocess, not a small sed match, and the comment three lines up already anticipates more
    # than one container answering for this service - exactly the case where head closing the pipe
    # early can turn an ordinary lookup into a SIGPIPE under this file's `set -Eeuo pipefail`.
    volume="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}' \
        "$(compose ps -aq "$service" 2>/dev/null | sed -n '1p')" 2>/dev/null || true)"
    compose rm -sf "$service"
    if [[ -z "$volume" ]]; then
        volume="$(docker volume ls -q \
            --filter "label=com.docker.compose.project=$(compose_project)" \
            --filter "label=com.docker.compose.volume=mc-${service}")"
    fi
    if [[ -z "$volume" ]]; then
        log "no mc-${service} volume was there; the container is gone"
    elif [[ "$(printf '%s\n' "$volume" | wc -l | tr -d ' ')" != "1" ]]; then
        die "more than one mc-${service} volume exists on this machine, so this cannot tell which
one belongs to this project. Delete it by name with docker volume rm:
${volume}"
    else
        docker volume rm "$volume" >/dev/null
        log "removed volume $volume"
    fi
    log "$service is reset. The next 'deploy/dev up' recreates it from an empty volume."
}

# --- dispatch ------------------------------------------------------------------------------------
command="${1:-}"
shift || true
case "$command" in
    init)    cmd_init "$@" ;;
    up)      cmd_up "$@" ;;
    deploy)  cmd_deploy "$@" ;;
    pack)    cmd_pack "$@" ;;
    ui)      cmd_ui "$@" ;;
    logs)    cmd_logs "$@" ;;
    ps)      cmd_ps "$@" ;;
    stop)    cmd_stop "$@" ;;
    down)    cmd_down "$@" ;;
    console) cmd_console "$@" ;;
    mc)      cmd_mc "$@" ;;
    psql)    cmd_psql "$@" ;;
    reset)   cmd_reset "$@" ;;
    ""|help|-h|--help)
        # Pattern-delimited rather than a line range: the header grows, and a range that has
        # gone stale prints a truncated help nobody notices (it had, by two lines).
        sed -n '/^# The local season 2 network/,/^# Everything here runs/p' "${BASH_SOURCE[0]}" \
            | sed 's/^# \{0,1\}//'
        ;;
    *)
        die "unknown command '$command'. Try: deploy/dev help"
        ;;
esac
