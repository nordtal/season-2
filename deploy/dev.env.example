# The settings of the local stack. `dev init` copies this file to deploy/dev.env and generates the
# secrets. The stack runs the production compose.yml and Dockerfiles with these values.
# See deploy/README.md#locally.

# Profiles: db, mc (the proxy and the three backends) and devpack (serves the local resource pack).
# steward always runs. Add `bot` only with a test guild.
COMPOSE_PROFILES=db,mc,devpack

# `dev up` builds every image of ours as nordtal/<name>:dev and never pulls one.
NORDTAL_IMAGES=nordtal
NORDTAL_RELEASE=dev

POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
# `dev init` generates this password and the role password of each service below. steward-agent
# creates the roles with them before it migrates.
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DISCORD_BOT_PASSWORD=REPLACE_ME
POSTGRES_PROXY_PASSWORD=REPLACE_ME
POSTGRES_LIMBO_PASSWORD=REPLACE_ME
POSTGRES_HUNGER_GAMES_PASSWORD=REPLACE_ME
POSTGRES_SMP_PASSWORD=REPLACE_ME
POSTGRES_STEWARD_PASSWORD=REPLACE_ME
# Postgres listens on loopback only, for psql or a JDBC client.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

EULA=true
# `dev init` generates the secret. The proxy and the backends must use the same one.
VELOCITY_FORWARDING_SECRET=REPLACE_ME
PROXY_BIND=127.0.0.1
PROXY_PORT=25565
# The address that a transfer names to the client, which runs on this machine.
NETWORK_PUBLIC_ADDRESS=127.0.0.1:25565
# The port of the standby proxy, published by caddy.
PROXY_STANDBY_PORT=25566
# The proxies sit behind caddy, so Velocity must read the PROXY header.
VELOCITY_HAPROXY=true

# Voice chat uses the port of the proxy and therefore works only from this machine.

PROXY_HEAP=512M
LIMBO_HEAP=512M
HUNGER_GAMES_HEAP=2G
SMP_HEAP=3G

# The whole java command line of a service. It replaces the heap setting and must include -Xmx.
PROXY_JVM_OPTS=
LIMBO_JVM_OPTS=
HUNGER_GAMES_JVM_OPTS=
SMP_JVM_OPTS=

# The nightly backup (`steward#backup.at`, 04:45) stops every server here too. To turn it off, blank
# the setting in Steward, on the settings of the steward service. The change applies without a restart.

# The datapacks are about 30 MB. Leave the variable empty to speed up a first start that needs no real terrain.
#SMP_DATAPACK_URLS=

# `dev pack` serves the pack on this port and sets the pack of the proxy to its URL and SHA-1.
# The port must differ from 8080, which steward uses.
PACK_PORT=8081
PACK_BIND=127.0.0.1

# compose.yml requires it. Almost nothing lives under it locally.
NORDTAL_DIR=./deploy/local
# Each service has its own secrets in <service>/secrets.env, which `dev init` writes. The file of
# discord-bot holds NORDTAL_BOT_TOKEN. The file of steward holds NORDTAL_STEWARD_WEB_DISCORD_CLIENT_SECRET
# and NORDTAL_STEWARD_WEB_WEB_PUSH_PRIVATE_KEY. steward-bunq/secrets.env would hold the bank key.
# Without that key bunq is off, and steward-bunq logs it at startup. There is no sandbox key.
# NORDTAL_STEWARD_WEB_TOTP_KEY (64 hex digits) in the file of steward offers the authenticator app.
# Without it, Steward does not offer the app.
NORDTAL_SECRETS_DIR=./deploy/local/secrets

# Volume names without `/`, so that `dev reset` can remove them.
PROXY_DATA=mc-proxy
LIMBO_DATA=mc-limbo
PROXY_STANDBY_DATA=mc-proxy-standby
LIMBO_STANDBY_DATA=mc-limbo-standby
HUNGER_GAMES_DATA=mc-hunger-games
SMP_DATA=mc-smp
POSTGRES_DATA=postgres-data
STEWARD_BACKUPS=steward-backups
BUNQ_CONTEXT=bunq-context
CADDY_DATA=caddy-data
CADDY_CONFIG=caddy-config

# Directories, so that configs can be edited and jars copied in. `dev` refuses volume names here.
PROXY_PLUGINS=./deploy/servers/proxy/plugins
LIMBO_PLUGINS=./deploy/servers/limbo/plugins
# steward fills it from the live services.
PROXY_STANDBY_PLUGINS=./deploy/servers/proxy-standby/plugins
LIMBO_STANDBY_PLUGINS=./deploy/servers/limbo-standby/plugins
HUNGER_GAMES_PLUGINS=./deploy/servers/hunger-games/plugins
SMP_PLUGINS=./deploy/servers/smp/plugins
PACK_ROOT=./deploy/pack

# Placeholders for the bot. Compose interpolates every service, selected or not. Before adding `bot`,
# set the real ids of a test guild. The bot cannot tell a test guild from the real one.
NORDTAL_ACCESS_GUILD_ID=0

# Placeholders for Steward. Caddy runs with `mc` and issues a local certificate for a `.localhost`
# name. `dev ui` starts the interface.
STEWARD_HOST=steward.localhost
STEWARD_ACME_EMAIL=nobody@example.invalid
# The address of the browser, here the Vite dev server. On a real deployment it stays empty.
STEWARD_PUBLIC_URL=http://localhost:5173
# It must be the host above or a parent of it.
STEWARD_WEBAUTHN_RP_ID=localhost
# Vite proxies /api and /auth to this port. `dev ui` refuses a port equal to PACK_PORT.
STEWARD_BIND=127.0.0.1
STEWARD_PORT=8080
# `dev init` generates the tokens.
STEWARD_AGENT_TOKEN=REPLACE_ME
STEWARD_BUNQ_TOKEN=REPLACE_ME
# The Discord sign-in. An empty value disables it. The redirect URI is https://<STEWARD_HOST>/auth/callback.
STEWARD_DISCORD_CLIENT_ID=
# Your own Discord id. This account may become the root of the empty admin tree.
STEWARD_ROOT_DISCORD_ID=
# The Web Push keys come from `steward generate-vapid-keys` in its container. The private key goes
# into the secrets.env of steward. An empty value hides the button.
STEWARD_WEB_PUSH_PUBLIC_KEY=
# No agent runs locally. These values point at something that exists and is never read.
STEWARD_ENV_FILE=/dev/null
STEWARD_ENV_DIR=/dev
STEWARD_ENV_FILE_NAME=null
