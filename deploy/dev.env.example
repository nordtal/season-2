# nordtal season 2 - the LOCAL stack
# Copy to deploy/dev.env and fill in the two generated values, or run `deploy/dev init` which does
# both. `*.env` is gitignored, so the copy never reaches this public repository.
#
# The point of this file is that there is no second compose file. The local stack is the production
# `compose.yml`, the production Dockerfiles and the production steward-worker, driven by a different
# set of variables. Everything that differs is below and can be read in one sitting; nothing that
# differs is hidden in an override whose merge nobody can picture.
#
# The runbook is deploy/README.md#locally.


# What comes up
# db      postgres
# mc      the proxy and the three backends
# devpack the nginx that serves the locally built resource pack on localhost
#
# steward-worker has no profile and is always in - it applies the schema and fills empty volumes.
# The bot is deliberately NOT here: it needs a real Discord guild and a real bunq key, and the
# placeholders further down are only there because compose interpolates the whole file, including
# services no profile selected. Add `bot` once you have a test guild.
COMPOSE_PROFILES=db,mc,devpack


# Images: built here, never pulled
# The defaults in compose.yml point at ghcr.io/nordtal, which is right on the host and wrong here:
# a locally built plugin needs the locally built steward-worker, because the migrations it runs are
# compiled into :common and shaded into that jar. `deploy/dev up` builds both images under these
# names, and a `:dev` tag can never be confused with something a release pushed.
MC_IMAGE=nordtal/minecraft:dev
STEWARD_WORKER_IMAGE=nordtal/steward-worker:dev
BOT_IMAGE=nordtal/discord-bot:dev

# Those two images take no build args and no version: their Dockerfiles glob build/libs for the jar
# Gradle has just produced. A SEASON_VERSION or BOT_VERSION written here drifts from the
# repository's own version the moment either one is bumped, which is the entire argument for not
# writing a version down twice.


# The database
POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
# Generated by `deploy/dev init`. Local, on loopback, and still not a word anybody has to type.
POSTGRES_PASSWORD=REPLACE_ME
# Published so you can point psql or a JDBC client at it. Loopback only.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432


# The network
EULA=true
# Generated by `deploy/dev init` (`openssl rand -hex 24`). The proxy and all three backends have to
# agree on it or every join fails with a forwarding error that names neither side.
VELOCITY_FORWARDING_SECRET=REPLACE_ME
PROXY_BIND=127.0.0.1
PROXY_PORT=25565
NETWORK_MAX_PLAYERS=20
# Where a client reaches this network, host and port, as the client itself would type it. It is
# what a transfer names to the player, so it cannot be a compose service name - and on a laptop the
# client is on this machine, which is why loopback is the honest answer here.
NETWORK_PUBLIC_ADDRESS=127.0.0.1:25565
# The second port, for the proxy that stands in while the first one restarts.
# It is published by `caddy` rather than by the standby itself, so it is open
# whether or not the standby is running - what is behind it only exists during a run.
PROXY_STANDBY_PORT=25566
# Whether the proxies stand behind the guard. `true` here and the entrypoint
# writes `haproxy-protocol = true` into velocity.toml on every start, which is what makes Velocity
# read the player's real address out of the header caddy writes. Leave it unset and velocity.toml is
# not touched at all; set it to `false` and the key is written back to false. The one thing that
# does not work is a value that disagrees with reality: a proxy behind the guard without the key
# answers nobody, and a proxy in front of nothing with it answers nobody either.
VELOCITY_HAPROXY=true

# Simple Voice Chat needs no variable: its one UDP port is the proxy's own, published on
# PROXY_BIND above. Bound to loopback here for the same reason the proxy and Postgres are - a
# laptop on somebody else's wifi should not be a voice server - which also means voice chat only
# works from a client on this machine, and that is what a local stack can say about it anyway.

# A laptop is not the production host. These four are the whole difference in load.
PROXY_HEAP=512M
LIMBO_HEAP=512M
HUNGER_GAMES_HEAP=2G
SMP_HEAP=3G

# The whole java command line for one Minecraft service, replacing what the entrypoint builds out of
# the HEAP above - so anything set here has to carry its own -Xms/-Xmx. Left empty on purpose; it is
# an escape hatch for a one-off flag, not the place heap sizes belong.
PROXY_JVM_OPTS=
LIMBO_JVM_OPTS=
HUNGER_GAMES_JVM_OPTS=
SMP_JVM_OPTS=

# steward-worker has a clock of its own: `backup.at` in
# steward.yml, default 04:45, and that service is in no compose profile - it runs in the local stack
# exactly as it runs in production. A laptop left on overnight therefore stops all four Minecraft
# servers at a quarter to five, tars every volume and starts them again, and the only trace in the
# morning is a `docker ps` uptime nobody looks at.
#
# There is deliberately NO variable here for it. The same name would have to live in the production
# .env, where a value left empty - by a copy of this file, or by somebody switching it off "just for
# tonight" - means no nightly backup ever again, silently, in the one place where the backup is the
# whole point. A setting that can only be wrong in the direction of losing data is not worth the
# convenience.
#
# Switch it off locally where the value actually lives, in the container's own config volume:
#
#   docker compose exec steward-worker sed -i '/^backup:/,/^[a-z]/ s/^  at: .*/  at: ""/' \
#       /app/config/steward.yml
#   docker compose restart steward-worker
#
# Blank is "never" (NightlyClock.from returns empty), and the start-up log says which it is - it
# prints the resolved time and the next firing on every boot, so one `docker compose logs
# steward-worker | grep nightly` confirms it either way. `deploy/dev down` at the end of the day is
# the other answer, and the one that costs nothing.

# The SMP's world generation datapacks are ~30 MB of download and change the terrain permanently.
# Left at the production default on purpose: a world generated without them is vanilla terrain for
# ever, and testing against terrain nobody will see is worth very little. Set it empty for a
# faster first start if you are working on something that does not touch the world.
#SMP_DATAPACK_URLS=


# The resource pack, served from this machine
# `deploy/dev pack` builds the zip, puts it in PACK_ROOT, and writes the URL and the SHA-1 into the
# proxy's pack.yml - which is a file on the host here, under PROXY_PLUGINS. The client runs
# on this machine, so localhost is the client's localhost too.
#
# 8081 and not 8080: steward-ui publishes itself
# on 8080 as well, and `deploy/dev ui` brings the whole stack up at once, so the two are on at the
# same time and the defaults cannot both be 8080. The pack URL is written by `deploy/dev pack`,
# which reads this value, so moving it costs nothing.
PACK_PORT=8081
PACK_BIND=127.0.0.1


# Where everything lives
# NORDTAL_DIR is the installation directory, and on the production host it is an absolute path that
# deploy/nordtal.sh writes: every volume in compose.yml defaults to a directory under it, so that
# the whole installation is one folder somebody can reach over SFTP. compose.yml refuses to
# interpolate without it, which is why it is here at all.
#
# Locally it is relative and it is barely used, because the six lines below name a volume for
# everything a local stack does not want as a directory. `deploy/dev` runs compose from the
# repository root, so a relative path resolves the way it reads - the production host cannot do
# that, because steward-deployer runs compose from /app inside its own image.
NORDTAL_DIR=./deploy/local

# This is where the local stack differs from production in its storage: compose.yml defaults every
# volume to a directory, and these lines put the ones a laptop has no use for as directories back
# into named volumes. A world, a jar cache and a database are things `deploy/dev reset` throws away
# by volume name; the plugin folders below are things you edit and copy jars into.
#
# Docker tells the two apart by nothing but the presence of a `/`.
PROXY_DATA=mc-proxy
LIMBO_DATA=mc-limbo
PROXY_STANDBY_DATA=mc-proxy-standby
LIMBO_STANDBY_DATA=mc-limbo-standby
HUNGER_GAMES_DATA=mc-hunger-games
SMP_DATA=mc-smp
POSTGRES_DATA=postgres-data
STEWARD_BACKUPS=steward-backups
BOT_CONFIG=bot-config
BOT_JAR=bot-jar
STEWARD_WORKER_CONFIG=steward-worker-config
STEWARD_WORKER_JAR=steward-worker-jar
STEWARD_UI_CONFIG=steward-ui-config
BUNQ_CONTEXT=bunq-context
CADDY_DATA=caddy-data
CADDY_CONFIG=caddy-config

# And the four that stay directories here, so that editing plugins/smp/config.yml is opening a file
# and installing a freshly built jar is a `cp`. `deploy/dev` reads these four by name and refuses to
# run if one of them is a volume name, because there is no `cp` into a volume.
#
# The service name is the directory name, and it has to be: `deploy/dev`, compose.yml and
# :steward-worker's Topology all use the same identity.
PROXY_PLUGINS=./deploy/servers/proxy/plugins
LIMBO_PLUGINS=./deploy/servers/limbo/plugins
# The two standbys' plugins/, directories for the same reason the four above are - and they are
# filled by steward-worker rather than by hand: every apply copies the live service's plugins/ onto
# its standby's. steward-worker mounts these two whether or not the `standby` profile is selected,
# so compose creates them on any local `up`.
PROXY_STANDBY_PLUGINS=./deploy/servers/proxy-standby/plugins
LIMBO_STANDBY_PLUGINS=./deploy/servers/limbo-standby/plugins
HUNGER_GAMES_PLUGINS=./deploy/servers/hunger-games/plugins
SMP_PLUGINS=./deploy/servers/smp/plugins
PACK_ROOT=./deploy/pack


# Stopping and starting - nothing to set. The worker uses the Docker socket compose.yml mounts into it, so
# `/smp update restart` and `deploy/dev deploy` work against a plain local stack with nothing extra
# installed. If your .env still has ARCANE_URL, ARCANE_API_KEY, ARCANE_ENVIRONMENT or ARCANE_PROJECT
# in it, delete those four lines; nothing reads them.


# The bot: placeholders, because compose interpolates the whole file
# Every `${X:?}` in compose.yml has to have a value even when its service is in no selected profile
# - compose interpolates before it filters. None of these is read by anything while `bot` is out of
# COMPOSE_PROFILES. If you add it, replace all of them with real ids from a test guild; the bot
# writes into channels and hands out roles, and it cannot tell a test guild from the real one.
#
# The same name, read a second time. steward-ui also reads NORDTAL_BOT_TOKEN, read-only and with
# `:-` rather than `:?` (compose.yml, the steward-ui service): asking Discord what the guild's roles
# and channels are called, so the config editor offers a list instead of an eighteen-digit field to
# transcribe. Nothing here is a separate placeholder for that - it is the one line above, doing
# both jobs, because it is the same variable and the same value either way.
NORDTAL_BOT_TOKEN=local-development-no-bot
NORDTAL_ACCESS_GUILD_ID=0
NORDTAL_ACCESS_ROLES_ACCESS=0
NORDTAL_ACCESS_ROLES_DONOR=0
NORDTAL_ACCESS_ROLES_ADMIN=0
NORDTAL_ACCESS_ROLES_ADMIN_PING=0
NORDTAL_ACCESS_CHANNELS_ADMIN=0
NORDTAL_ACCESS_LANGUAGES='[{"tag":"en","role":"0","contribution-channel":"0","link-channel":"0","hunger-games-channel":"0"},{"tag":"de","role":"0","contribution-channel":"0","link-channel":"0","hunger-games-channel":"0"}]'


# The bank: renamed and deliberately EMPTY
# These were NORDTAL_BOT_BUNQ_API_KEY and NORDTAL_BOT_BUNQ_ACCOUNT_ID on the bot, with the
# placeholders `local-development-no-bunq` and `0`. bunq moved into steward-worker, and the
# placeholders went with the move rather than being renamed with it: a non-empty key is a key as far
# as the config is concerned, so a placeholder made every local stack fail a bunq call every thirty
# seconds for no reason.
#
# Empty is unset to jcore, which is exactly right here. A local stack has no bank account, and
# steward-worker says so in one line at startup:
#
#   bunq is OFF: bunq.api-key and bunq.account-id are both empty in steward.yml ...
#
# Fill both in only against a REAL account - there is no bunq sandbox key - and read that line
# afterwards to see it flip to "bunq is ON".
NORDTAL_STEWARD_BUNQ_API_KEY=
NORDTAL_STEWARD_BUNQ_ACCOUNT_ID=


# Steward: placeholders too, for the same reason
# steward-ui and steward-deployer are behind the `steward` profile and are NOT in the selection
# above - the local stack has no name and no Discord application. Caddy IS in it, through `mc`: it
# is the guard in front of the game port, and its configuration always carries the interface's
# site too, so running the network means running with these two values set. For a `.localhost`
# name Caddy issues the certificate from its own local authority and asks Let's Encrypt nothing.
# The values exist in any case because compose interpolates the whole file before it filters by
# profile, and a `${X:?}` in a service nobody selected still stops the command.
#
# To bring the interface up locally: `deploy/dev ui`, which starts the stack COMPOSE_PROFILES
# selects and then names the steward services rather than adding their profile. The browser
# reaches steward-ui directly on the loopback port below, or through the Vite dev server in front
# of it.
#
# The three values below are why the container could not start at all without them. compose.yml
# built the public URL as `https://${STEWARD_HOST}` and passed no WebAuthn variable through, so
# `relying-party-id` stayed on its production default and `Configs.requireRelyingParty` refused
# the container - correctly, and with the exact sentence it was written for.
STEWARD_HOST=steward.localhost
STEWARD_ACME_EMAIL=nobody@example.invalid
# The address the browser uses, which locally is not `https://<host>`. Leave it empty on a real
# deployment: then STEWARD_HOST is the only name, as before. With the Vite dev server in front it
# is `http://localhost:5173`; without one it is the container's own loopback port below.
STEWARD_UI_PUBLIC_URL=http://localhost:5173
# The domain security keys are registered against. It has to be the host of the address above or
# a parent of it, or steward-ui refuses to start. `localhost` is allowed and is the only single
# label that is. Empty means the value in steward-ui.yml stands.
STEWARD_WEBAUTHN_RP_ID=localhost
# Where steward-ui publishes itself on this machine. Loopback by default, in production too. This
# is the port Vite proxies /api and /auth to, so moving it means moving vite.config.ts with it -
# which is why PACK_PORT moved instead when the two collided. `deploy/dev ui`
# refuses to start when they are equal rather than letting Docker explain it.
STEWARD_UI_BIND=127.0.0.1
STEWARD_UI_PORT=8080
# Two different secrets on a real host: one lets the interface read containers, the other lets it
# create them - and two here as well, since the local steward stack needs both to start at all.
# REPLACE_ME is this project's marker for "a line exists so the file is complete, not because
# anybody answered it"; `deploy/dev init` generates both, the same way nordtal.sh does.
STEWARD_API_TOKEN=REPLACE_ME
STEWARD_DEPLOYER_TOKEN=REPLACE_ME
# Discord sign-in for the interface (compose.yml's steward-ui service, `:-` and not `:?`: empty
# means nobody can sign in, and the sign-in page names the one that is missing rather than failing
# at Discord). Blank here, the same shape as the two tokens above - `steward` is out of
# COMPOSE_PROFILES by default, so nothing reads these locally either. A real Discord application's
# OAuth2 page has both; its redirect URI has to be https://<STEWARD_HOST>/auth/callback.
STEWARD_UI_DISCORD_CLIENT_ID=
STEWARD_UI_DISCORD_CLIENT_SECRET=
# A VAPID keypair for Web Push, blank meaning "not configured" - the subscribe button
# is then simply not drawn, the same shape as the tokens above. Not `${X:?}` for exactly that
# reason, and safe to leave blank here: jcore's EnvOverlay treats a set-but-empty variable the same
# as an unset one, so it can never blank out a keypair steward-ui.yml already has on a real host.
# `deploy/nordtal.sh` mints a real pair itself on a fresh production install - nothing
# to do there. Locally, or to replace a pair by hand, generate one the same way it does:
# `docker exec nordtal-s2-steward-ui-1 steward-ui generate-vapid-keys`.
STEWARD_UI_WEB_PUSH_PUBLIC_KEY=
STEWARD_UI_WEB_PUSH_PRIVATE_KEY=
# The absolute path of this file on the host, which steward-deployer mounts read-only so compose
# inside it can interpolate. Locally there is no deployer, so it points at something that exists
# and is never read.
STEWARD_ENV_FILE=/dev/null
# steward-deployer mounts the directory of the file above, not the file itself, and is
# told the file's name separately - dirname and basename of STEWARD_ENV_FILE, spelled out here
# because there is no deployer locally to derive them. Consistent with /dev/null above.
STEWARD_ENV_DIR=/dev
STEWARD_ENV_FILE_NAME=null
