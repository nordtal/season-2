# nordtal season 2: the local stack. `dev init` copies this to deploy/dev.env and generates the
# secrets. It runs the production compose.yml and Dockerfiles; only these values differ.
# See deploy/README.md#locally.

# db, mc (the proxy and the three backends) and devpack (serves the local resource pack).
# steward-worker always runs. Add `bot` only with a test guild.
COMPOSE_PROFILES=db,mc,devpack

# Built locally by `dev up`; the worker carries the migrations the plugins expect.
MC_IMAGE=nordtal/minecraft:dev
STEWARD_WORKER_IMAGE=nordtal/steward-worker:dev
BOT_IMAGE=nordtal/discord-bot:dev

POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
# Generated by `dev init`, and so is each service's own role password below; steward-worker creates
# the roles with them before it migrates.
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DISCORD_BOT_PASSWORD=REPLACE_ME
POSTGRES_PROXY_PASSWORD=REPLACE_ME
POSTGRES_LIMBO_PASSWORD=REPLACE_ME
POSTGRES_HUNGER_GAMES_PASSWORD=REPLACE_ME
POSTGRES_SMP_PASSWORD=REPLACE_ME
POSTGRES_STEWARD_UI_PASSWORD=REPLACE_ME
# Loopback only, for psql or a JDBC client.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

EULA=true
# Generated by `dev init`; the proxy and the backends must agree on it.
VELOCITY_FORWARDING_SECRET=REPLACE_ME
PROXY_BIND=127.0.0.1
PROXY_PORT=25565
NETWORK_MAX_PLAYERS=20
# The address a transfer names to the client, which runs on this machine.
NETWORK_PUBLIC_ADDRESS=127.0.0.1:25565
# The standby proxy's port, published by caddy.
PROXY_STANDBY_PORT=25566
# The proxies sit behind caddy, so Velocity must read its PROXY header.
VELOCITY_HAPROXY=true

# Voice chat uses the proxy's port and therefore only works from this machine.

PROXY_HEAP=512M
LIMBO_HEAP=512M
HUNGER_GAMES_HEAP=2G
SMP_HEAP=3G

# A service's whole java command line, replacing the heap setting; include -Xmx.
PROXY_JVM_OPTS=
LIMBO_JVM_OPTS=
HUNGER_GAMES_JVM_OPTS=
SMP_JVM_OPTS=

# The nightly backup (steward.yml `backup.at`, 04:45) stops every server here too. To turn it off
# locally, blank it in the container's config:
#
#   docker compose exec steward-worker sed -i '/^backup:/,/^[a-z]/ s/^  at: .*/  at: ""/' \
#       /app/config/steward.yml
#   docker compose restart steward-worker

# The datapacks are about 30 MB; empty speeds up a first start that does not need real terrain.
#SMP_DATAPACK_URLS=

# `dev pack` serves the pack here and writes its URL and SHA-1 into the proxy's pack.yml.
# Not 8080, which steward-ui uses.
PACK_PORT=8081
PACK_BIND=127.0.0.1

# Required by compose.yml; locally almost nothing lives under it.
NORDTAL_DIR=./deploy/local

# Volume names (no `/`), so `dev reset` can remove them.
PROXY_DATA=mc-proxy
LIMBO_DATA=mc-limbo
PROXY_STANDBY_DATA=mc-proxy-standby
LIMBO_STANDBY_DATA=mc-limbo-standby
HUNGER_GAMES_DATA=mc-hunger-games
SMP_DATA=mc-smp
POSTGRES_DATA=postgres-data
STEWARD_BACKUPS=steward-backups
BOT_CONFIG=bot-config
BOT_JAR=bot-jar
STEWARD_WORKER_CONFIG=steward-worker-config
STEWARD_WORKER_JAR=steward-worker-jar
STEWARD_UI_CONFIG=steward-ui-config
BUNQ_CONTEXT=bunq-context
CADDY_DATA=caddy-data
CADDY_CONFIG=caddy-config

# Directories, so configs can be edited and jars copied in; `dev` refuses volume names here.
PROXY_PLUGINS=./deploy/servers/proxy/plugins
LIMBO_PLUGINS=./deploy/servers/limbo/plugins
# Filled by steward-worker from the live services.
PROXY_STANDBY_PLUGINS=./deploy/servers/proxy-standby/plugins
LIMBO_STANDBY_PLUGINS=./deploy/servers/limbo-standby/plugins
HUNGER_GAMES_PLUGINS=./deploy/servers/hunger-games/plugins
SMP_PLUGINS=./deploy/servers/smp/plugins
PACK_ROOT=./deploy/pack

# Bot placeholders: compose interpolates every service, selected or not. Use a test guild's real
# ids before adding `bot`; the bot cannot tell a test guild from the real one.
NORDTAL_BOT_TOKEN=local-development-no-bot
NORDTAL_ACCESS_GUILD_ID=0
NORDTAL_ACCESS_ROLES_ADMIN=0

# Empty turns bunq off, which the worker logs at startup. There is no sandbox key.
NORDTAL_STEWARD_BUNQ_API_KEY=
NORDTAL_STEWARD_BUNQ_ACCOUNT_ID=

# Steward placeholders, for the same reason. Caddy runs with `mc` and issues a local certificate for
# a `.localhost` name. `dev ui` starts the interface.
STEWARD_HOST=steward.localhost
STEWARD_ACME_EMAIL=nobody@example.invalid
# The browser's address: the Vite dev server here. Leave it empty on a real deployment.
STEWARD_UI_PUBLIC_URL=http://localhost:5173
# Must be the host above or a parent of it.
STEWARD_WEBAUTHN_RP_ID=localhost
# Vite proxies /api and /auth to this port; `dev ui` refuses it equal to PACK_PORT.
STEWARD_UI_BIND=127.0.0.1
STEWARD_UI_PORT=8080
# Generated by `dev init`.
STEWARD_API_TOKEN=REPLACE_ME
STEWARD_DEPLOYER_TOKEN=REPLACE_ME
# Discord sign-in; empty disables it. The redirect URI is https://<STEWARD_HOST>/auth/callback.
STEWARD_UI_DISCORD_CLIENT_ID=
STEWARD_UI_DISCORD_CLIENT_SECRET=
# Web Push keys from `steward-ui generate-vapid-keys` in its container; empty hides the button.
STEWARD_UI_WEB_PUSH_PUBLIC_KEY=
STEWARD_UI_WEB_PUSH_PRIVATE_KEY=
# No deployer runs locally, so these point at something that exists and is never read.
STEWARD_ENV_FILE=/dev/null
STEWARD_ENV_DIR=/dev
STEWARD_ENV_FILE_NAME=null
