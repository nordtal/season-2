# ------------------------------------------------------------------------------------------------
# nordtal season 2 - the LOCAL stack
# ------------------------------------------------------------------------------------------------
# Copy to deploy/dev.env and fill in the two generated values, or run `deploy/dev init` which does
# both. `*.env` is gitignored, so the copy never reaches this public repository.
#
# THE POINT OF THIS FILE IS THAT THERE IS NO SECOND COMPOSE FILE. The local stack is the production
# `compose.yml`, the production Dockerfiles and the production steward-worker, driven by a different
# set of variables. Everything that differs is below and can be read in one sitting; nothing that
# differs is hidden in an override whose merge nobody can picture.
#
# The runbook is deploy/README.md#locally.
# ------------------------------------------------------------------------------------------------


# ------------------------------------------------------------------------------------------------
# What comes up
# ------------------------------------------------------------------------------------------------
# db      postgres
# mc      the proxy and the three backends
# devpack the nginx that serves the locally built resource pack on localhost
#
# steward-worker has no profile and is always in - it applies the schema and fills empty volumes.
# The bot is deliberately NOT here: it needs a real Discord guild and a real bunq key, and the
# placeholders further down are only there because compose interpolates the whole file, including
# services no profile selected. Add `bot` once you have a test guild.
COMPOSE_PROFILES=db,mc,devpack


# ------------------------------------------------------------------------------------------------
# Images: built here, never pulled
# ------------------------------------------------------------------------------------------------
# The defaults in compose.yml point at ghcr.io/nordtal, which is right on the host and wrong here:
# a locally built plugin needs the locally built steward-worker, because the migrations it runs are
# compiled into :common and shaded into that jar. `deploy/dev up` builds both images under these
# names, and a `:dev` tag can never be confused with something a release pushed.
MC_IMAGE=nordtal/minecraft:dev
STEWARD_WORKER_IMAGE=nordtal/steward-worker:dev
BOT_IMAGE=nordtal/discord-bot:dev

# Those two images take no build args and no version: their Dockerfiles glob build/libs for the jar
# Gradle has just produced. SEASON_VERSION and BOT_VERSION stood here until 2026-09-09 saying 0.6.0
# against a repository on 0.8.1, which is the entire argument for not writing a version down twice.


# ------------------------------------------------------------------------------------------------
# The database
# ------------------------------------------------------------------------------------------------
POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
# Generated by `deploy/dev init`. Local, on loopback, and still not a word anybody has to type.
POSTGRES_PASSWORD=REPLACE_ME
# Published so you can point psql or a JDBC client at it. Loopback only.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------------------------
# The network
# ------------------------------------------------------------------------------------------------
EULA=true
# Generated by `deploy/dev init` (`openssl rand -hex 24`). The proxy and all three backends have to
# agree on it or every join fails with a forwarding error that names neither side.
VELOCITY_FORWARDING_SECRET=REPLACE_ME
PROXY_BIND=127.0.0.1
PROXY_PORT=25565
NETWORK_MAX_PLAYERS=20

# Simple Voice Chat needs no variable: its one UDP port is the proxy's own, published on
# PROXY_BIND above. Bound to loopback here for the same reason the proxy and Postgres are - a
# laptop on somebody else's wifi should not be a voice server - which also means voice chat only
# works from a client on this machine, and that is what a local stack can say about it anyway.

# A laptop is not the production host. These four are the whole difference in load.
PROXY_HEAP=512M
LIMBO_HEAP=512M
HUNGER_GAMES_HEAP=2G
SMP_HEAP=3G

# THE ONE THAT ACTUALLY MATTERS ON A LAPTOP. smp starts pre-generating tomorrow's farm world in its
# onEnable, and Chunky takes every core it is given - so the minutes after every `up` are spent at
# full load. Off here; the cost is that the first daily reset postpones itself once and builds the
# world then. See smp's config.yml#pregeneration-on-start, which says the same thing at length.
SMP_PREGENERATION_ON_START=false

# NO FARM-RESET BACKUP REQUIREMENT ON A LAPTOP. This is not a clock and it asks for nothing: it is
# how recently a backup must have succeeded before smp is willing to reset the farm world, and zero
# turns that check off (BackupGate#isOff, which says so at WARN on every start). It used to read as
# though smp ordered a backup at 04:45; the nightly clock moved to steward-worker on 2026-09-13 and
# this value never was one. Off here, because a local stack has nothing that makes backups and the
# reset would otherwise refuse for the life of the season.
SMP_FARM_RESET_BACKUP_WINDOW_HOURS=0

# AND THE LINE ABOVE IS NOT THE WHOLE CLOCK. steward-worker has one of its own: `backup.at` in
# steward.yml, default 04:45, and that service is in no compose profile - it runs in the local stack
# exactly as it runs in production. A laptop left on overnight therefore stops all four Minecraft
# servers at a quarter to five, tars every volume and starts them again, and the only trace in the
# morning is a `docker ps` uptime nobody looks at.
#
# There is deliberately NO variable here for it. The same name would have to live in the production
# .env, where a value left empty - by a copy of this file, or by somebody switching it off "just for
# tonight" - means no nightly backup ever again, silently, in the one place where the backup is the
# whole point. A setting that can only be wrong in the direction of losing data is not worth the
# convenience.
#
# Switch it off locally where the value actually lives, in the container's own config volume:
#
#   docker compose exec steward-worker sed -i '/^backup:/,/^[a-z]/ s/^  at: .*/  at: ""/' \
#       /app/config/steward.yml
#   docker compose restart steward-worker
#
# Blank is "never" (NightlyClock.from returns empty), and the start-up log says which it is - it
# prints the resolved time and the next firing on every boot, so one `docker compose logs
# steward-worker | grep nightly` confirms it either way. `deploy/dev down` at the end of the day is
# the other answer, and the one that costs nothing.

# The SMP's world generation datapacks are ~30 MB of download and change the terrain permanently.
# Left at the production default on purpose: a farm world generated without them is vanilla terrain
# for ever, and testing against terrain nobody will see is worth very little. Set it empty for a
# faster first start if you are working on something that does not touch the world.
#SMP_DATAPACK_URLS=


# ------------------------------------------------------------------------------------------------
# The resource pack, served from this machine
# ------------------------------------------------------------------------------------------------
# `deploy/dev pack` builds the zip, puts it in PACK_ROOT, and writes the URL and the SHA-1 into the
# proxy's pack.yml - which is a file on the host here, under NETWORK_CONTROL_PLUGINS. The client runs
# on this machine, so localhost is the client's localhost too.
PACK_PORT=8080
PACK_BIND=127.0.0.1


# ------------------------------------------------------------------------------------------------
# Where plugins/ lives
# ------------------------------------------------------------------------------------------------
# THIS IS THE ONE PLACE THE LOCAL STACK DIFFERS FROM PRODUCTION IN ITS STORAGE, and it is on
# purpose. compose.yml defaults each of these four to a VOLUME NAME (mc-<service>-plugins), because
# on the production host the alternative put every hand-edited config inside a directory the
# deployment checks out over - which deletes ignored files. Here they are paths, so that editing
# plugins/smp/config.yml is opening a file and installing a freshly built jar is a `cp`.
#
# Docker tells the two apart by nothing but the presence of a `/`. `deploy/dev` reads these four by
# name and refuses to run if one of them is a volume name, because there is no `cp` into a volume.
#
# The service name is the directory name, and it has to be: `deploy/dev`, compose.yml and
# :steward-worker's Topology all use the same identity.
NETWORK_CONTROL_PLUGINS=./deploy/servers/network-control/plugins
LIMBO_PLUGINS=./deploy/servers/limbo/plugins
HUNGER_GAMES_PLUGINS=./deploy/servers/hunger-games/plugins
SMP_PLUGINS=./deploy/servers/smp/plugins
PACK_ROOT=./deploy/pack


# ------------------------------------------------------------------------------------------------
# Stopping and starting - nothing to set
# ------------------------------------------------------------------------------------------------
# There is nothing here any more. Until 2026-09-13 a local restart needed a management panel running
# beside this stack and four ARCANE_* variables pointing at it, and setting that up was the only way
# to rehearse an update at all. The worker now uses the Docker socket compose.yml mounts into it, so
# `/smp update restart` and `deploy/dev deploy` work against a plain local stack with nothing extra
# installed. If your .env still has ARCANE_URL, ARCANE_API_KEY, ARCANE_ENVIRONMENT or ARCANE_PROJECT
# in it, delete those four lines; nothing reads them.


# ------------------------------------------------------------------------------------------------
# The bot: placeholders, because compose interpolates the whole file
# ------------------------------------------------------------------------------------------------
# Every `${X:?}` in compose.yml has to have a value even when its service is in no selected profile
# - compose interpolates before it filters. None of these is read by anything while `bot` is out of
# COMPOSE_PROFILES. If you add it, replace all of them with real ids from a TEST guild; the bot
# writes into channels and hands out roles, and it cannot tell a test guild from the real one.
NORDTAL_BOT_TOKEN=local-development-no-bot
NORDTAL_ACCESS_GUILD_ID=0
NORDTAL_ACCESS_ROLES_ACCESS=0
NORDTAL_ACCESS_ROLES_DONOR=0
NORDTAL_ACCESS_ROLES_ADMIN=0
NORDTAL_ACCESS_ROLES_ADMIN_PING=0
NORDTAL_ACCESS_CHANNELS_ADMIN=0
NORDTAL_ACCESS_LANGUAGES='[{"tag":"en","role":"0","contribution-channel":"0","link-channel":"0","hunger-games-channel":"0"},{"tag":"de","role":"0","contribution-channel":"0","link-channel":"0","hunger-games-channel":"0"}]'


# ------------------------------------------------------------------------------------------------
# The bank: renamed and deliberately EMPTY (steward/109)
# ------------------------------------------------------------------------------------------------
# These were NORDTAL_BOT_BUNQ_API_KEY and NORDTAL_BOT_BUNQ_ACCOUNT_ID on the bot, with the
# placeholders `local-development-no-bunq` and `0`. bunq moved into steward-worker, and the
# placeholders went with the move rather than being renamed with it: a non-empty key is a key as far
# as the config is concerned, so a placeholder made every local stack fail a bunq call every thirty
# seconds for no reason.
#
# EMPTY IS UNSET to jcore, which is exactly right here. A local stack has no bank account, and
# steward-worker says so in one line at startup:
#
#   bunq is OFF: bunq.api-key and bunq.account-id are both empty in steward.yml ...
#
# Fill both in only against a REAL account - there is no bunq sandbox key - and read that line
# afterwards to see it flip to "bunq is ON".
NORDTAL_STEWARD_BUNQ_API_KEY=
NORDTAL_STEWARD_BUNQ_ACCOUNT_ID=


# ------------------------------------------------------------------------------------------------
# Steward: placeholders too, for the same reason
# ------------------------------------------------------------------------------------------------
# steward-ui, steward-deployer and caddy are behind the `steward` profile and are NOT in the
# selection above - the local stack has no name, no certificate and no Discord application. These
# values exist because compose interpolates the whole file before it filters by profile, and a
# `${X:?}` in a service nobody selected still stops the command.
#
# To bring the interface up locally anyway: add `steward` to COMPOSE_PROFILES, put real secrets in
# the three below, and expect Caddy to fail to get a certificate for a name that is not this
# machine. `deploy/dev` does not do this, deliberately - what the interface needs to be tested
# against is the host it runs on.
STEWARD_HOST=steward.localhost
STEWARD_ACME_EMAIL=nobody@example.invalid
# Two DIFFERENT secrets on a real host: one lets the interface read containers, the other lets it
# create them. Here they are placeholders that nothing reads.
STEWARD_API_TOKEN=local-development-no-worker-api
STEWARD_DEPLOYER_TOKEN=local-development-no-deployer
# The absolute path of this file on the host, which steward-deployer mounts read-only so compose
# inside it can interpolate. Locally there is no deployer, so it points at something that exists
# and is never read.
STEWARD_ENV_FILE=/dev/null
# steward/102: steward-deployer mounts the DIRECTORY of the file above, not the file itself, and is
# told the file's name separately - dirname and basename of STEWARD_ENV_FILE, spelled out here
# because there is no deployer locally to derive them. Consistent with /dev/null above.
STEWARD_ENV_DIR=/dev
STEWARD_ENV_FILE_NAME=null
