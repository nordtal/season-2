# Loads nordtal.nft before the network and Docker start, so that no published port is open without a filter.
[Unit]
Description=nordtal inbound firewall
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nordtal/firewall.nft

[Install]
WantedBy=sysinit.target
