#!/usr/sbin/nft -f
# The inbound filter of the host. From outside it admits only SSH and the game port, and the standby
# port while proxy-standby runs. From the tailnet it admits SSH, HTTPS and T3 Code. The web names reach Caddy through the Cloudflare tunnel. Published ports of Docker pass the forward hook, so
# this table filters them too. Docker never touches a table of its own.

# The port of this host's sshd.
define ssh = 420

# Docker's bridges: the default one and one per network of compose. Their traffic is the containers'
# own, to each other, to the host and out. Everything else, from any interface, meets the rules below,
# so the table needs no name of the public interface and cannot admit everything by a wrong one.
define docker = { "docker0", "br-*" }

# Tailscale's interface. Only devices of the tailnet reach it, and it admits SSH, HTTPS and T3 Code,
# nothing else. T3 Code listens on loopback unless it is bound to the tailnet address. HTTPS is
# tailscale serve, which publishes Atelier to the tailnet.
define tailscale = "tailscale0"
define https = 443
define t3 = 3773

# Declared, then deleted, so that loading the file replaces the table in one transaction.
table inet nordtal
delete table inet nordtal

table inet nordtal {
# PROXY_PORT.
	set public_tcp {
		type inet_service
		elements = { 25565 }
	}

# Voice chat on PROXY_PORT.
	set public_udp {
		type inet_service
		elements = { 25565 }
	}

# PROXY_STANDBY_PORT, TCP and UDP, while proxy-standby runs. standby-port.sh fills the set.
	set standby {
		type inet_service
	}

# New connections per source address and minute. A source above the rate waits until its bucket
# refills; the timeout forgets a source that stopped connecting. SSH: at most 16 logins a minute were
# seen from one address, so the limit leaves room for four times that. The game port: a client opens
# one connection to join and one per refresh of the server list.
	set ssh_new4 {
		type ipv4_addr
		flags dynamic
		timeout 5m
	}

	set ssh_new6 {
		type ipv6_addr
		flags dynamic
		timeout 5m
	}

	set game_new4 {
		type ipv4_addr
		flags dynamic
		timeout 5m
	}

	set game_new6 {
		type ipv6_addr
		flags dynamic
		timeout 5m
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif lo accept
		iifname $docker accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto { icmp, ipv6-icmp } accept
		iifname $tailscale tcp dport { $ssh, $https, $t3 } accept
		tcp dport $ssh ct state new update @ssh_new4 { ip saddr limit rate over 64/minute burst 128 packets } drop
		tcp dport $ssh ct state new update @ssh_new6 { ip6 saddr limit rate over 64/minute burst 128 packets } drop
		tcp dport $ssh accept
		tcp dport @public_tcp ct state new update @game_new4 { ip saddr limit rate over 30/minute burst 60 packets } drop
		tcp dport @public_tcp ct state new update @game_new6 { ip6 saddr limit rate over 30/minute burst 60 packets } drop
		tcp dport @public_tcp accept
		udp dport @public_udp accept
		meta l4proto { tcp, udp } th dport @standby accept
	}

# After the DNAT of Docker, so that a rule matches a published port by the port the client asked for.
	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname $docker accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto tcp ct original proto-dst @public_tcp ct state new update @game_new4 { ip saddr limit rate over 30/minute burst 60 packets } drop
		meta l4proto tcp ct original proto-dst @public_tcp ct state new update @game_new6 { ip6 saddr limit rate over 30/minute burst 60 packets } drop
		meta l4proto tcp ct original proto-dst @public_tcp accept
		meta l4proto udp ct original proto-dst @public_udp accept
		meta l4proto { tcp, udp } ct original proto-dst @standby accept
	}
}
