#!/usr/sbin/nft -f
# The host's inbound filter: from outside only SSH, the web and the game port, plus the standby port
# while proxy-standby runs. Docker's published ports pass the forward hook, so this table filters them
# too; Docker never touches a table of its own.

# This host's public interface and its sshd Port.
define wan = "eth0"
define ssh = 420

# Declared, then deleted, so loading the file replaces the table in one transaction.
table inet nordtal
delete table inet nordtal

table inet nordtal {
	# Caddy's HTTP and HTTPS, and PROXY_PORT.
	set public_tcp {
		type inet_service
		elements = { 80, 443, 25565 }
	}

	# HTTP/3, and voice chat on PROXY_PORT.
	set public_udp {
		type inet_service
		elements = { 443, 25565 }
	}

	# PROXY_STANDBY_PORT, TCP and UDP, while proxy-standby runs; standby-port.sh fills it.
	set standby {
		type inet_service
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iifname != $wan accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto { icmp, ipv6-icmp } accept
		tcp dport $ssh accept
		tcp dport @public_tcp accept
		udp dport @public_udp accept
		meta l4proto { tcp, udp } th dport @standby accept
	}

	# After Docker's DNAT, so a published port is matched by the port the client asked for.
	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname != $wan accept
		ct state established,related accept
		ct state invalid drop
		meta l4proto tcp ct original proto-dst @public_tcp accept
		meta l4proto udp ct original proto-dst @public_udp accept
		meta l4proto { tcp, udp } ct original proto-dst @standby accept
	}
}
