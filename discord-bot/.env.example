# Copy to .env and fill in. .env is gitignored; this file must never carry a real value.
#
#   cp .env.example .env
#
# Every variable here is an override for one setting in one of the bot's three config files.
# The name is the setting's path with '.' and '-' turned into '_', prefixed by the file's
# namespace. An EMPTY value counts as unset and leaves the file's own default in place, so the
# optional block at the bottom can stay empty.

# --- what to run ------------------------------------------------------------------------------
# The released image, or one you built locally:
#   ../gradlew :discord-bot:shadowJar
#   docker build -t ghcr.io/nordtal/discord-bot:2.0.0 --build-arg JAR=build/libs/discord-bot-2.0.0.jar .
BOT_IMAGE=ghcr.io/nordtal/discord-bot:2.0.0

# Set to 'db' to run PostgreSQL in this compose too. Leave empty to run only the bot against a
# database that already exists.
COMPOSE_PROFILES=db

TZ=Europe/Berlin

# --- PostgreSQL (only read when COMPOSE_PROFILES=db) ------------------------------------------
POSTGRES_DB=nordtal
POSTGRES_USER=nordtal
POSTGRES_PASSWORD=
# The proxy and the Paper plugins read the same database. While they are not deployed yet, leave
# this on loopback; when they are, set POSTGRES_BIND to the interface their host can reach.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# --- database.yml -----------------------------------------------------------------------------
# Defaults to this compose's own PostgreSQL. Point it elsewhere for a managed database.
NORDTAL_DATABASE_JDBC_URL=
NORDTAL_DATABASE_USERNAME=
NORDTAL_DATABASE_PASSWORD=

# --- bot.yml ----------------------------------------------------------------------------------
NORDTAL_BOT_TOKEN=
NORDTAL_BOT_BUNQ_API_KEY=
# The monetary account id, numeric.
NORDTAL_BOT_BUNQ_ACCOUNT_ID=
# SANDBOX or PRODUCTION. The bunq context file belongs to one environment: switching means
# deleting the bunq-context volume so a fresh context is registered.
NORDTAL_BOT_BUNQ_ENVIRONMENT=SANDBOX

# --- access.yml: ids ---------------------------------------------------------------------------
# These have no usable defaults on purpose. The bot refuses to start until they are real.
NORDTAL_ACCESS_GUILD_ID=
NORDTAL_ACCESS_ROLES_ACCESS=
NORDTAL_ACCESS_ROLES_DONOR=
NORDTAL_ACCESS_ROLES_ADMIN=
NORDTAL_ACCESS_ROLES_ADMIN_PING=
NORDTAL_ACCESS_CHANNELS_ADMIN=

# The language list, as JSON. This is the ONLY source for the language roles and the per-language
# channels; adding a language is an entry here plus a <tag>.properties bundle in the jar. 'en' must
# be present. Keys are the config keys, not the Java names. Keep it on one line.
NORDTAL_ACCESS_LANGUAGES=[{"tag":"en","role":"","contribution-channel":"","link-channel":"","hunger-games-channel":""},{"tag":"de","role":"","contribution-channel":"","link-channel":"","hunger-games-channel":""}]

# --- access.yml: optional (empty = keep the file's value) --------------------------------------
# Tiers as JSON. Empty means 30/60/90 days at 3/5/7 EUR. A tier is identified by its day count.
NORDTAL_ACCESS_TIERS=
NORDTAL_ACCESS_DONATION_CENTS=
NORDTAL_ACCESS_PAYMENT_POLL_INTERVAL_SECONDS=
NORDTAL_ACCESS_PAYMENT_REQUEST_TTL_HOURS=
# Leave empty on a fresh database - the first start stamps the watermark itself.
NORDTAL_ACCESS_PAYMENT_WATERMARK=
NORDTAL_ACCESS_PAYMENT_RECENT_PAYMENT_COUNT=
NORDTAL_ACCESS_EXPIRY_REMINDER_LEAD_DAYS=
NORDTAL_ACCESS_ROLE_RECONCILE_INTERVAL_MINUTES=
NORDTAL_DATABASE_MAXIMUM_POOL_SIZE=
NORDTAL_DATABASE_LOG_SQL=
