{
  "parts": [
    {
      "type": "CONTAINER",
      "parts": [
        {
          "type": "GALLERY",
          "media": ["attachment://contribution.png"]
        },
        {
          "type": "TEXT",
          "lines": [
            {
              "text": {
                "en": "Access",
                "de": "{@terms.access}"
              },
              "style": "TITLE"
            }
          ]
        },
        {
          "type": "TEXT",
          "lines": [
            {
              "text": {
                "en": "With {@terms.access} you can join the server.",
                "de": "Mit {@terms.access} kannst du auf den Server."
              }
            },
            {
              "list": "tiers",
              "text": {
                "en": "**{@values.duration.days, n=days}** for {price}",
                "de": "**{@values.duration.days, n=days}** für {price}"
              }
            }
          ]
        },
        {
          "type": "ROW",
          "items": [
            {
              "slot": "buy",
              "label": {
                "en": "Buy {@terms.access}",
                "de": "{@terms.access} kaufen"
              }
            }
          ]
        },
        {
          "type": "SEPARATOR"
        },
        {
          "type": "TEXT",
          "lines": [
            {
              "text": {
                "en": "Buying again extends your {@terms.access}.",
                "de": "Ein weiterer Kauf verlängert deinen {@terms.access}."
              }
            },
            {
              "text": {
                "en": "A donation of {amount} added to your purchase gives you the permanent donor role.",
                "de": "Eine Spende von {amount} zu deinem Kauf gibt dir die dauerhafte Spenderrolle."
              }
            }
          ]
        }
      ]
    }
  ]
}
