{
  "parts": [
    {
      "type": "CONTAINER",
      "parts": [
        {
          "type": "TEXT",
          "lines": [
            {
              "text": {
                "en": "Your purchase",
                "de": "Dein Kauf"
              },
              "style": "TITLE"
            }
          ]
        },
        {
          "type": "TEXT",
          "lines": [
            {
              "text": {
                "en": "**{@values.duration.days, n=days} of {@terms.access}** for {price}",
                "de": "**{@values.duration.days, n=days} {@terms.access}** für {price}"
              }
            },
            {
              "text": {
                "en": "**Donation:** {donation} for the permanent donor role",
                "de": "**Spende:** {donation} für die dauerhafte Spenderrolle"
              },
              "when": "donating"
            },
            {
              "text": {
                "en": "Total: **{total}**",
                "de": "Gesamt: **{total}**"
              },
              "when": "donating"
            }
          ]
        },
        {
          "type": "ROW",
          "items": [
            {
              "slot": "confirm",
              "label": {
                "en": "Create payment link",
                "de": "Zahlungslink erstellen"
              }
            },
            {
              "slot": "change",
              "label": {
                "en": "Change {@terms.period, n=1}",
                "de": "{@terms.period, n=1} ändern"
              }
            },
            {
              "slot": "withdraw",
              "label": {
                "en": "Remove donation",
                "de": "Spende entfernen"
              }
            },
            {
              "slot": "donate",
              "label": {
                "en": "Add a {amount} donation",
                "de": "{amount} spenden"
              }
            }
          ]
        }
      ]
    }
  ]
