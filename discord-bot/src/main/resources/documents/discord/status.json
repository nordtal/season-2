{
  "parts": [
    {
      "type": "TEXT",
      "when": "state=closed",
      "lines": [
        {
          "text": {
            "en": "Launch date to come",
            "de": "Starttermin folgt"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "state=countdown",
      "lines": [
        {
          "text": {
            "en": "Opens in {days} d {hours} h",
            "de": "Start in {days} d {hours} h"
          },
          "when": "countdown=days"
        },
        {
          "text": {
            "en": "Opens in {hours} h",
            "de": "Start in {hours} h"
          },
          "when": "countdown=hours"
        },
        {
          "text": {
            "en": "Opens in {minutes} min",
            "de": "Start in {minutes} min"
          },
          "when": "countdown=minutes"
        },
        {
          "text": {
            "en": "Opens any moment",
            "de": "Startet gleich"
          },
          "when": "countdown=imminent"
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "state=maintenance",
      "lines": [
        {
          "text": {
            "en": "Maintenance",
            "de": "Wartung"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "state=smp",
      "lines": [
        {
          "text": {
            "en": "{players} {@terms.player, n=players}",
            "de": "{players} {@terms.player, n=players}"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "state=hunger-games",
      "lines": [
        {
          "text": {
            "en": "{teams} {@terms.team, n=teams} registered",
            "de": "{teams} {@terms.team, n=teams} angemeldet"
          },
          "when": "!playing"
        },
        {
          "text": {
            "en": "{teams} {@terms.team, n=teams} left, {players} alive",
            "de": "{teams} {@terms.team, n=teams} übrig, {players} am Leben"
          },
          "when": "playing"
        }
      ]
    }
  ]
}
