{
  "parts": [
    {
      "type": "TEXT",
      "when": "phase=pre-launch",
      "lines": [
        {
          "text": {
            "en": "Opens in {days}d {hours}h",
            "de": "Start in {days}T {hours}Std"
          },
          "when": "countdown=days"
        },
        {
          "text": {
            "en": "Opens in {hours}h",
            "de": "Start in {hours}Std"
          },
          "when": "countdown=hours"
        },
        {
          "text": {
            "en": "Opens in {minutes} min",
            "de": "Start in {minutes} Min"
          },
          "when": "countdown=minutes"
        },
        {
          "text": {
            "en": "Opens any moment",
            "de": "Start jeden Moment"
          },
          "when": "countdown=imminent"
        },
        {
          "text": {
            "en": "Opening date to come",
            "de": "Starttermin folgt"
          },
          "when": "countdown=unknown"
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "phase=pre-event",
      "lines": [
        {
          "text": {
            "en": "{teams} {@terms.team, n=teams} registered",
            "de": "{teams} {@terms.team, n=teams} angemeldet"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "phase=start-event",
      "lines": [
        {
          "text": {
            "en": "{teams} {@terms.team, n=teams} left, {players} alive",
            "de": "{teams} {@terms.team, n=teams} übrig, {players} am Leben"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "phase=smp",
      "lines": [
        {
          "text": {
            "en": "{players} {@terms.player, n=players}",
            "de": "{players} {@terms.player, n=players}"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "when": "phase=maintenance",
      "lines": [
        {
          "text": {
            "en": "Maintenance",
            "de": "Wartung"
          }
        }
      ]
    }
  ]
}
