<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- An <encoder>, not a <layout>: a layout works but logback warns about it, and a
             logback WARN makes it print its entire startup status report - twenty-five lines of
             configurator chatter above the first real log line of every container start. -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Hikari announces every pool state change at DEBUG; Flyway narrates each migration at
         INFO, which is worth keeping. jcore's SQL logger sits on
         eu.nordtal.jcore.persistence.sql.Slf4jSqlLogger at DEBUG and is off unless log_sql is
         enabled in config/database.yml AND this logger is turned up. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.jdbi" level="INFO"/>

    <root level="info">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>