<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n
            </Pattern>
        </layout>
    </appender>

    <!-- Hikari announces every pool state change at DEBUG; Flyway narrates each migration at
         INFO, which is worth keeping. jcore's SQL logger sits on
         eu.nordtal.jcore.persistence.sql.Slf4jSqlLogger at DEBUG and is off unless log_sql is
         enabled in config/database.json AND this logger is turned up. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.jdbi" level="INFO"/>

    <root level="info">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>