{
  "parts": [
    {
      "type": "TEXT",
      "lines": [
        {
          "when": "occasion=update",
          "text": {
            "en": "<warn><emphasis>{@values.service}</emphasis> is being updated now.</warn>",
            "de": "<warn><emphasis>{@values.service}</emphasis> wird jetzt aktualisiert.</warn>"
          }
        },
        {
          "when": "occasion=recreate",
          "text": {
            "en": "<warn><emphasis>{@values.service}</emphasis> is restarting now.</warn>",
            "de": "<warn><emphasis>{@values.service}</emphasis> startet jetzt neu.</warn>"
          }
        },
        {
          "when": "occasion=backup",
          "text": {
            "en": "<warn><emphasis>{@values.service}</emphasis> is being backed up now.</warn>",
            "de": "<warn><emphasis>{@values.service}</emphasis> wird jetzt gesichert.</warn>"
          }
        },
        {
          "when": "occasion=down",
          "text": {
            "en": "<warn><emphasis>{@values.service}</emphasis> is going down now.</warn>",
            "de": "<warn><emphasis>{@values.service}</emphasis> geht jetzt offline.</warn>"
          }
        },
        {
          "when": "occasion=pack",
          "text": {
            "en": "<warn>The resource pack is being updated now.</warn> <muted>You can move again once it has loaded.</muted>",
            "de": "<warn>Das Ressourcenpaket wird jetzt aktualisiert.</warn> <muted>Sobald es geladen ist, kannst du dich wieder bewegen.</muted>"
          }
        },
        {
          "when": "occasion=maintenance",
          "text": {
            "en": "<warn>Nordtal is going down now.</warn>",
            "de": "<warn>Nordtal geht jetzt offline.</warn>"
          }
        }
      ]
    }
  ]
}
