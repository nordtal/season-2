{
  "parts": [
    {
      "type": "TEXT",
      "lines": [
        {
          "text": {
            "en": "<brand><bold>nordtal.eu</bold></brand>",
            "de": "<brand><bold>nordtal.eu</bold></brand>"
          }
        }
      ]
    },
    {
      "type": "TEXT",
      "lines": [
        {
          "when": "countdown=days",
          "text": {
            "en": "<muted>{season.name} opens in <emphasis>{@values.duration.days, n=days} {@values.duration.hours, n=hours}</emphasis></muted>",
            "de": "<muted>{season.name} öffnet in <emphasis>{@values.duration.days, n=days, case=dative} {@values.duration.hours, n=hours}</emphasis></muted>"
          }
        },
        {
          "when": "countdown=hours",
          "text": {
            "en": "<muted>{season.name} opens in <emphasis>{@values.duration.hours, n=hours} {@values.duration.minutes, n=minutes}</emphasis></muted>",
            "de": "<muted>{season.name} öffnet in <emphasis>{@values.duration.hours, n=hours} {@values.duration.minutes, n=minutes}</emphasis></muted>"
          }
        },
        {
          "when": "countdown=minutes",
          "text": {
            "en": "<muted>{season.name} opens in <emphasis>{@values.duration.minutes, n=minutes}</emphasis></muted>",
            "de": "<muted>{season.name} öffnet in <emphasis>{@values.duration.minutes, n=minutes}</emphasis></muted>"
          }
        },
        {
          "when": "countdown=imminent",
          "text": {
            "en": "<muted>{season.name} opens in <emphasis>any moment now</emphasis></muted>",
            "de": "<muted>{season.name} öffnet in <emphasis>jedem Moment</emphasis></muted>"
          }
        }
      ],
      "when": "state=countdown"
    },
    {
      "type": "TEXT",
      "lines": [
        {
          "when": "state=closed",
          "text": {
            "en": "<muted>{season.name} is closed. The opening date is not announced yet.</muted>",
            "de": "<muted>{season.name} ist geschlossen. Der Eröffnungstermin steht noch nicht fest.</muted>"
          }
        },
        {
          "when": "state=maintenance",
          "text": {
            "en": "<muted>The {@terms.network} is down for maintenance.</muted>",
            "de": "<muted>Das {@terms.network} ist wegen Wartung offline.</muted>"
          }
        },
        {
          "when": "state=hunger-games",
          "text": {
            "en": "<muted>{@terms.hunger-games}: <emphasis>{list.hgParticipants}</emphasis> {@terms.player, n=list.hgParticipants} in <emphasis>{list.hgTeams}</emphasis> {@terms.team, n=list.hgTeams}</muted>",
            "de": "<muted>{@terms.hunger-games}: <emphasis>{list.hgParticipants}</emphasis> {@terms.player, n=list.hgParticipants} in <emphasis>{list.hgTeams}</emphasis> {@terms.team, n=list.hgTeams}</muted>"
          }
        },
        {
          "when": "state=smp",
          "text": {
            "en": "<muted>{season.name} is running. <emphasis>{list.smpMilestonesDone}</emphasis> of <emphasis>{list.smpMilestones}</emphasis> {@terms.milestone, n=list.smpMilestones} done.</muted>",
            "de": "<muted>{season.name} läuft. <emphasis>{list.smpMilestonesDone}</emphasis> von <emphasis>{list.smpMilestones}</emphasis> {@terms.milestone, n=list.smpMilestones, case=dative} geschafft.</muted>"
          }
        }
      ]
    }
  ]
}
