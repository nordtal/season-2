diff --git a/common/webapp/src/components/Nordtal/NordtalHeader.vue b/common/webapp/src/components/Nordtal/NordtalHeader.vue
new file mode 100644
index 00000000..985b85d4
--- /dev/null
+++ b/common/webapp/src/components/Nordtal/NordtalHeader.vue
@@ -0,0 +1,80 @@
+<template>
+  <header class="nordtal-header">
+    <a class="logo" href="https://nordtal.eu"><img src="../../assets/nordtal-logo.png" alt="Nordtal"></a>
+    <nav class="maps">
+      <button v-for="map of appState.maps" :key="map.id"
+              :class="{active: mapViewer.map && mapViewer.map.id === map.id}"
+              @click="$bluemap.switchMap(map.id).then(() => $bluemap.resetCamera())">{{ map.name }}</button>
+    </nav>
+    <span class="players" v-if="!playerMarkerSet.fake">{{ playerMarkerSet.markers.length }}</span>
+  </header>
+</template>
+
+<script>
+export default {
+  name: "NordtalHeader",
+  data() {
+    return {
+      appState: this.$bluemap.appState,
+      mapViewer: this.$bluemap.mapViewer.data,
+      markers: this.$bluemap.mapViewer.markers.data,
+    };
+  },
+  computed: {
+    playerMarkerSet() {
+      return this.markers.markerSets.find(set => set.id === "bm-players") || {markers: [], fake: true};
+    },
+  },
+};
+</script>
+
+<style lang="scss">
+@import "/src/scss/variables.scss";
+
+.nordtal-header {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 3rem;
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding: 0 1rem;
+  background-color: var(--theme-bg);
+  border-bottom: 1px solid var(--theme-bg-light);
+  color: var(--theme-fg);
+  pointer-events: auto;
+
+  .logo img {
+    height: 1.5rem;
+    image-rendering: pixelated;
+  }
+
+  .maps {
+    display: flex;
+    gap: 0.25rem;
+    overflow-x: auto;
+
+    button {
+      padding: 0.25rem 0.75rem;
+      border: none;
+      border-radius: 0.375rem;
+      background: none;
+      color: var(--theme-fg-light);
+      font: inherit;
+      cursor: pointer;
+
+      &.active {
+        background-color: var(--theme-switch-button-on);
+        color: var(--theme-fg);
+      }
+    }
+  }
+
+  .players {
+    margin-left: auto;
+    color: var(--theme-fg-light);
+  }
+}
+</style>
