{
  "parts": [
    {
      "type": "TEXT",
      "lines": [
        {
          "style": "TITLE",
          "text": {
            "en": "Milestone",
            "de": "{@terms.milestone, n=1}"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "summary",
      "lines": [
        {
          "text": {
            "en": "{done} of {total} {@terms.objective, n=total} finished",
            "de": "{done} von {total} {@terms.objective, n=total, case=dative} geschafft"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "count",
      "lines": [
        {
          "text": {
            "en": "{amount}/{target}",
            "de": "{amount}/{target}"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "finished",
      "lines": [
        {
          "text": {
            "en": "Finished",
            "de": "Geschafft"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "counts",
      "lines": [
        {
          "text": {
            "en": "Counts: {items}",
            "de": "Zählt: {items}"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "part",
      "lines": [
        {
          "text": {
            "en": "Your part: {percent}%",
            "de": "Dein Beitrag: {percent} %"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "hand-in-hint",
      "lines": [
        {
          "text": {
            "en": "Hand in items",
            "de": "Gegenstände abgeben"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "counted",
      "lines": [
        {
          "text": {
            "en": "Counted automatically",
            "de": "Wird automatisch gezählt"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "hand-in-words",
      "lines": [
        {
          "text": {
            "en": "Hand-in, counts: {items}",
            "de": "Abgabe, zählt: {items}"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "hand-in-words-shared",
      "lines": [
        {
          "text": {
            "en": "Hand-in, counts: {items}. Your part: {percent}%",
            "de": "Abgabe, zählt: {items}. Dein Beitrag: {percent} %"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "counted-words",
      "lines": [
        {
          "text": {
            "en": "counted automatically",
            "de": "wird automatisch gezählt"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "share",
      "lines": [
        {
          "text": {
            "en": "Your share: {spins} of {budget} {@terms.extra-spin, n=budget}",
            "de": "Dein Anteil: {spins} von {budget} {@terms.extra-spin, n=budget}"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "share-none",
      "lines": [
        {
          "text": {
            "en": "Nothing put in yet",
            "de": "Noch nichts beigetragen"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "share-title",
      "lines": [
        {
          "text": {
            "en": "Your part",
            "de": "Dein Beitrag"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "share-row",
      "lines": [
        {
          "text": {
            "en": "{objective} {percent}%",
            "de": "{objective} {percent} %"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "not-started",
      "lines": [
        {
          "text": {
            "en": "The {@terms.season} has not started yet",
            "de": "Die {@terms.season} hat noch nicht begonnen"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "none",
      "lines": [
        {
          "text": {
            "en": "No milestone right now",
            "de": "Gerade läuft kein {@terms.milestone, n=1}"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "all",
      "lines": [
        {
          "text": {
            "en": "Every milestone is finished.",
            "de": "Alle {@terms.milestone, n=2} sind geschafft."
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "pager",
      "lines": [
        {
          "text": {
            "en": "Next page, previous page, page {page} of {pages}",
            "de": "Nächste Seite, vorherige Seite, Seite {page} von {pages}"
          }
        }
      ]
    }
  ]
}
