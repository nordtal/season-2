{
  "parts": [
    {
      "type": "TEXT",
      "lines": [
        {
          "style": "TITLE",
          "text": {
            "en": "Where to?",
            "de": "Wohin?"
          }
        }
      ]
    },
    {
      "type": "ITEM",
      "slot": "station",
      "lines": [
        {
          "text": {
            "en": "<emphasis>{name}</emphasis>",
            "de": "<emphasis>{name}</emphasis>"
          }
        },
        {
          "text": {
            "en": "<muted>{distance} m along the rails</muted>",
            "de": "<muted>{distance} m über die Schienen</muted>"
          }
        },
        {
          "when": "favourite",
          "text": {
            "en": "<muted>One of your favourites.</muted>",
            "de": "<muted>Einer deiner Favoriten.</muted>"
          }
        }
      ]
    },
    {
      "type": "LABEL",
      "slot": "distance",
      "lines": [
        {
          "text": {
            "en": "{distance} m",
            "de": "{distance} m"
          }
        }
      ]
    },
    {
      "type": "ITEM",
      "slot": "favourite",
      "lines": [
        {
          "when": "!favourite",
          "text": {
            "en": "<emphasis>Add to favourites</emphasis>",
            "de": "<emphasis>Zu den Favoriten hinzufügen</emphasis>"
          }
        },
        {
          "when": "favourite",
          "text": {
            "en": "<emphasis>Remove from favourites</emphasis>",
            "de": "<emphasis>Aus den Favoriten entfernen</emphasis>"
          }
        },
