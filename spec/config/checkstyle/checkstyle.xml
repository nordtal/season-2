<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- The checked part of CONVENTIONS.md. Formatting is Spotless's, not this file's.
     codeSeverity is "ignore" while a module enforces only the comment rules. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="FileLength">
        <property name="severity" value="${codeSeverity}" default="error"/>
        <property name="max" value="800"/>
    </module>

    <module name="RegexpMultiline">
        <property name="id" value="docFirstLine"/>
        <property name="format"
                  value="/\*\*([ \t]+[^@\s*][^\r\n]*|[ \t]*\r?\n[ \t]*\*[ \t]+[^@\s][^\r\n]*)[^.!?}\s][ \t]*\r?\n[ \t]*\*[ \t]*[^\s@/]"/>
        <property name="message" value="The first sentence of a doc comment fits on its first line."/>
    </module>
    <module name="RegexpMultiline">
        <property name="id" value="inlineOneLine"/>
        <property name="format" value="^[ \t]*//[^\r\n]*\r?\n[ \t]*//"/>
        <property name="message" value="An inline comment is one line."/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="commentLength"/>
        <property name="format" value="^(?=.{121,}$)\s*(//|/\*|\*)"/>
        <property name="message" value="A comment line fits in 120 columns."/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="markdownDoc"/>
        <property name="format" value="^\s*///"/>
        <property name="message" value="Doc comments use /** */, not ///."/>
    </module>
    <module name="RegexpSingleline">
        <property name="id" value="blockHtml"/>
        <property name="format"
                  value="(?i)^\s*(/\*\*|\*).*&lt;/?(p|h[1-6]|ul|ol|li|pre|table|tr|td|th|blockquote|div|dl|dt|dd|hr|br)\b[^&gt;]*&gt;"/>
        <property name="message" value="No block HTML in doc comments."/>
    </module>

    <module name="TreeWalker">
        <module name="TodoComment">
            <property name="id" value="todo"/>
            <property name="format" value="\b(TODO|FIXME|XXX)\b"/>
            <message key="todo.match" value="No TODO, FIXME or XXX: open work is an issue in the tracker."/>
        </module>
        <module name="TodoComment">
            <property name="id" value="date"/>
            <property name="format" value="\b\d{4}-\d{2}-\d{2}\b"/>
            <message key="todo.match" value="No dates in comments: a comment describes the code as it is now."/>
        </module>
        <module name="TodoComment">
            <property name="id" value="banner"/>
            <property name="format" value="(-{4,}|={4,}|\*{4,}|#{4,}|/{4,}|_{4,}|~{4,})"/>
            <message key="todo.match" value="No banner comments."/>
        </module>

        <module name="FinalLocalVariable">
            <property name="severity" value="${codeSeverity}" default="error"/>
            <property name="validateEnhancedForLoopVariable" value="true"/>
        </module>
        <module name="FinalParameters">
            <property name="severity" value="${codeSeverity}" default="error"/>
        </module>
        <module name="MethodLength">
            <property name="severity" value="${codeSeverity}" default="error"/>
            <property name="max" value="60"/>
        </module>
        <module name="AvoidStarImport">
            <property name="severity" value="${codeSeverity}" default="error"/>
        </module>
        <module name="IllegalImport">
            <property name="severity" value="${codeSeverity}" default="error"/>
            <property name="illegalClasses" value="org.junit.jupiter.api.DisplayName"/>
            <property name="illegalPkgs" value="org.jetbrains.annotations, javax.annotation"/>
        </module>

        <!-- Public API documentation: severity "error" where CONVENTIONS.md makes it mandatory. -->
        <module name="MissingJavadocType">
            <property name="severity" value="${apiDocSeverity}" default="ignore"/>
            <property name="scope" value="protected"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="severity" value="${apiDocSeverity}" default="ignore"/>
            <property name="scope" value="protected"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
            <property name="minLineCount" value="1"/>
        </module>
        <module name="JavadocVariable">
            <property name="severity" value="${apiDocSeverity}" default="ignore"/>
            <property name="accessModifiers" value="public, protected"/>
        </module>
        <module name="JavadocMethod">
            <property name="severity" value="${apiDocSeverity}" default="ignore"/>
            <property name="accessModifiers" value="public, protected"/>
            <property name="validateThrows" value="false"/>
        </module>
    </module>
</module>
