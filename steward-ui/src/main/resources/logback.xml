<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Without this file logback logs Jetty at DEBUG, which floods the log search the service page reads. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- An encoder, since a layout warns and a warning prints logback's whole status report. -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Jetty and Javalin narrate every connection at DEBUG; their WARNs are kept. -->
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.javalin" level="INFO"/>
    <!-- The pool narrates every state change at DEBUG; its INFO lines matter when a database goes away. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.jdbi" level="INFO"/>

    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
