<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Stderr, not stdout: this process prints its result - the plan and what was done - on
         stdout, and that text is read, pasted and put into a Discord embed. Log lines interleaved
         with it would break all three. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <!-- An <encoder>, not a <layout>: a layout warns, and a logback warning makes logback print
             its entire startup status report on stdout - the stream this program's output lives on. -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Hikari narrates every pool state change at DEBUG, which for a pool that lives one migration
         is six lines of nothing. Flyway's own INFO lines stay: they are the record of what happened
         to the schema. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.jdbi" level="INFO"/>

    <root level="info">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
