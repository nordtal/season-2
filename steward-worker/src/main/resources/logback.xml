<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Stderr, since stdout carries the result that is pasted into Discord. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <!-- An encoder, since a layout warns and a warning prints logback's status report on stdout. -->
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Hikari's DEBUG pool narration is noise; Flyway's INFO lines stay as the schema's record. -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.jdbi" level="INFO"/>

    <root level="info">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
