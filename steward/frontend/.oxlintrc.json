{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "max-lines": [
      "error",
      {
        "max": 800,
        "skipBlankLines": false,
        "skipComments": false
      }
    ]
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist/**"],
  "overrides": [
    {
      "files": ["src/main.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/lib/api.gen.ts", "src/lib/texts.gen.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}
